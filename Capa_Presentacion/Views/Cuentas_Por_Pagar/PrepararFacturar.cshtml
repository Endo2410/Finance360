@model List<Capa_Entidad.OrdenCompra>

@{
    ViewData["Title"] = "Preparación de Facturas OC";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var facturasPendientes = Model;
}

<ol class="breadcrumb mb-4 mt-4">
    <li class="breadcrumb-item">
        <a asp-controller="Home" asp-action="Bienevenido">Inicio</a>
    </li>
    <li class="breadcrumb-item active">
        Preparación de Facturas
    </li>
</ol>

<div class="card shadow border-0">

    <div class="card-header text-white" style="background-color:#274DF5;">
        <i class="fas fa-file-invoice-dollar me-2"></i>
        Preparación de Facturas Orden Compra
    </div>

    <div class="card-body">

        <div class="row mb-3">

            <div class="col-md-4">

                <label>Proveedor</label>

                <div class="input-group">

                    <input type="text"
                           id="txtProveedorSeleccionado"
                           class="form-control"
                           readonly>

                    <button class="btn btn-primary"
                            id="btnAbrirModalProveedor">

                        <i class="fas fa-search"></i>

                    </button>

                </div>

            </div>

        </div>

        <table class="table table-striped" id="tablaFacturas">

            <thead class="text-white" style="background-color:#274DF5;">

                <tr>

                    <th></th>
                    <th>Orden</th>
                    <th>Factura</th>
                    <th>Proveedor</th>
                    <th class="text-center">Total</th>

                </tr>

            </thead>

            <tbody></tbody>

        </table>

        <button id="btnPreparar" class="btn btn-primary">

            <i class="fas fa-check"></i>
            Preparar Facturas

        </button>

    </div>
</div>



<!-- MODAL PROVEEDORES -->

<div class="modal fade" id="modalProveedores">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header bg-primary text-white">

                <h5 class="modal-title">
                    Seleccionar Proveedor
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"></button>

            </div>

            <div class="modal-body">

                <div class="row mb-3">

                    <div class="col-md-6">
                        <label>Fecha Inicio</label>
                        <input type="date" id="fechaInicio" class="form-control">
                    </div>

                    <div class="col-md-6">
                        <label>Fecha Fin</label>
                        <input type="date" id="fechaFin" class="form-control">
                    </div>

                </div>

                <table class="table table-hover">

                    <thead>

                        <tr>
                            <th>Proveedor</th>
                            <th></th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var p in facturasPendientes.Select(x => x.Proveedor).Distinct())
                        {
                            <tr>

                                <td>@p</td>

                                <td>

                                    <button class="btn btn-success btn-sm btnSeleccionarProveedor"
                                            data-nombre="@p">

                                        Seleccionar

                                    </button>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    </div>
</div>



<!-- MODAL PREPARACION -->

<div class="modal fade" id="modalPreparacion">

    <div class="modal-dialog modal-xl">

        <div class="modal-content">

            <div class="modal-header bg-primary text-white">

                <h5 class="modal-title">
                    Preparación de Pago
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"></button>

            </div>

            <div class="modal-body">

                <h6 class="fw-bold text-primary">
                    Facturas Seleccionadas
                </h6>

                <table class="table table-sm table-bordered"
                       id="tablaFacturasSeleccionadas">

                    <thead class="table-primary text-center">

                        <tr>
                            <th>Orden</th>
                            <th>Factura</th>
                            <th>Proveedor</th>
                            <th class="text-end">Total</th>
                        </tr>

                    </thead>

                    <tbody></tbody>

                </table>

                <div class="alert alert-success d-flex justify-content-between">

                    <strong>Total Facturas</strong>

                    <span id="lblTotal" data-total="0"></span>

                </div>

                <hr>

                <!-- RETENCIONES -->
                <h6 class="fw-bold text-danger">
                    Retenciones
                </h6>

                <select id="cmbRetenciones" class="form-control mb-2">

                    <option value="">-- Seleccionar retención --</option>

                </select>

                <div id="contenedorRetenciones"></div>

                <div class="alert alert-warning d-flex justify-content-between">

                    <strong>Total Retenciones</strong>

                    <span id="lblTotalRetenciones" data-total="0">

                        C$0.00

                    </span>

                </div>

                <hr>


                <!-- DESCUENTO -->

                <h6 class="fw-bold text-info">
                    Descuento Pronto Pago
                </h6>

                <select id="cmbDescuento" class="form-control mb-2">
                    <option value="">-- Seleccionar descuento --</option>
                </select>

                <div id="contenedorDescuentos"></div>

                <div class="alert alert-info d-flex justify-content-between">
                    <strong>Total Descuento</strong>
                    <span id="lblTotalDescuento" data-total="0">
                        C$0.00
                    </span>
                </div>

                <hr>

                <div class="alert alert-primary d-flex justify-content-between">

                    <strong>Total Neto a Pagar</strong>

                    <span id="lblTotalNeto" data-total="0">

                        C$0.00

                    </span>

                </div>

            </div>

            <div class="modal-footer">

                <button id="btnGuardarPreparacion"
                        class="btn btn-primary">

                    Guardar Preparación

                </button>

            </div>

        </div>

    </div>

</div>


@section scripts{

<script>

    const todasFacturas =
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        facturasPendientes.Select(x => new {

            x.IdOrden,
            x.NumeroOrden,
            x.Proveedor,
            x.Factura,
            x.Total,
            Fecha = x.FechaCreacion.ToString("yyyy-MM-dd")

        })
    ));

    function fMonto(m){

        return m.toLocaleString('es-NI',
        {
            style:'currency',
            currency:'NIO'
        });

    }

    $('#btnAbrirModalProveedor').click(function(){

        new bootstrap.Modal(
        document.getElementById('modalProveedores')
        ).show();

    });


    $(document).on('click', '.btnSeleccionarProveedor', function () {

        let prov = $(this).data('nombre');

        let fechaInicio = $('#fechaInicio').val();
        let fechaFin = $('#fechaFin').val();

        // VALIDAR FECHAS
        if (fechaInicio && fechaFin && fechaInicio > fechaFin) {
            alert("La fecha inicio no puede ser mayor que la fecha fin");
            return;
        }

        $('#txtProveedorSeleccionado').val(prov);

        let tabla = $('#tablaFacturas').DataTable();
        tabla.clear();

        let lista = todasFacturas.filter(x => {

            let fecha = new Date(x.Fecha);

            let cumpleProveedor = x.Proveedor === prov;

            let cumpleInicio = !fechaInicio || fecha >= new Date(fechaInicio);

            let cumpleFin = !fechaFin || fecha <= new Date(fechaFin);

            return cumpleProveedor && cumpleInicio && cumpleFin;

        });

        lista.forEach(e => {

            tabla.row.add([
                `<input type="checkbox"
                class="chkFactura"
                value="${e.IdOrden}"
                data-monto="${e.Total}">`,
                e.NumeroOrden,
                e.Factura,
                e.Proveedor,
                fMonto(e.Total)
            ]);

        });

        tabla.draw();

        bootstrap.Modal
            .getInstance(document.getElementById('modalProveedores'))
            .hide();

    });

    // ================================
    // CARGAR RETENCIONES
    // ================================

    $.get('/TipoRetencion/Listar', function (res) {

        let cmb = $('#cmbRetenciones');

        cmb.empty().append('<option value="">-- Seleccionar retención --</option>');

        res.forEach(r => {

            cmb.append(`
            <option value="${r.id}" data-porcentaje="${r.porcentaje}">
                ${r.nombre} (${r.porcentaje}%)
            </option>
        `);

        });

    });

    $('#cmbRetenciones').change(function () {

        let option = $(this).find('option:selected');

        let id = option.val();
        if (!id) return;

        let nombre = option.text();
        let porcentaje = option.data('porcentaje');

        $('#contenedorRetenciones').append(`

        <div class="form-check retencion-item">

            <input class="form-check-input chkRetencion"
                   type="checkbox"
                   checked
                   data-porcentaje="${porcentaje}">

            <label class="form-check-label">
                ${nombre}
            </label>

        </div>

    `);

        option.remove();

        $('#cmbRetenciones').val('');

        calcularTotales();

    });

    $(document).on('change', '.chkRetencion', function () {

        calcularTotales();

    });


    // ================================
    // CARGAR DESCUENTOS
    // ================================

    $.get('/TipoRetencion/ListarDescuento', function (res) {

        let cmb = $('#cmbDescuento');

        cmb.empty().append('<option value="">-- Seleccionar descuento --</option>');

        res.forEach(d => {

            cmb.append(`
            <option value="${d.id}" data-porcentaje="${d.porcentaje}">
                ${d.nombre} (${d.porcentaje}%)
            </option>
        `);

        });

    });

    $('#cmbDescuento').change(function () {

        let option = $(this).find('option:selected');

        let id = option.val();
        if (!id) return;

        let nombre = option.text();
        let porcentaje = option.data('porcentaje');

        $('#contenedorDescuentos').append(`

        <div class="form-check descuento-item">

            <input class="form-check-input chkDescuento"
                   type="checkbox"
                   checked
                   data-porcentaje="${porcentaje}">

            <label class="form-check-label">
                ${nombre}
            </label>

        </div>

    `);

        option.remove();

        $('#cmbDescuento').val('');

        calcularTotales();

    });

    $(document).on('change', '.chkDescuento', function () {

        calcularTotales();

    });



    $('#btnPreparar').click(function(){

        let seleccionadas = $('.chkFactura:checked');

        if(seleccionadas.length == 0){
        alert('Seleccione facturas');
        return;
        }

        let total = 0;

        let tbody = $('#tablaFacturasSeleccionadas tbody');
        tbody.empty();

        seleccionadas.each(function(){

            let fila = $(this).closest('tr');

            let monto = parseFloat($(this).data('monto'));

            total += monto;

            tbody.append(`
                <tr>
                <td>${fila.find('td:eq(1)').text()}</td>
                <td>${fila.find('td:eq(2)').text()}</td>
                <td>${fila.find('td:eq(3)').text()}</td>
                <td class="text-end">
                ${fila.find('td:eq(4)').text()}
                </td>
                </tr>
                `);

        });

        $('#lblTotal')
        .data('total', total)
        .text(fMonto(total));

        calcularTotales();

        new bootstrap.Modal(
        document.getElementById('modalPreparacion')
        ).show();

    });


    function calcularTotales(){

        let total = parseFloat($('#lblTotal').data('total')) || 0;

        let totalRet = 0;

        $('.chkRetencion:checked').each(function(){

            let p = parseFloat($(this).data('porcentaje'));
            totalRet += total * (p/100);

        });

        let totalDesc = 0;

        $('.chkDescuento:checked').each(function () {

            let p = parseFloat($(this).data('porcentaje'));
            totalDesc += total * (p / 100);

        });

        let neto = total - totalRet - totalDesc;

        $('#lblTotalRetenciones')
        .data('total', totalRet)
        .text(fMonto(totalRet));

        $('#lblTotalDescuento')
        .data('total', totalDesc)
        .text(fMonto(totalDesc));

        $('#lblTotalNeto')
        .data('total', neto)
        .text(fMonto(neto));
        }

        $('#cmbDescuento').change(function(){
        calcularTotales();
    });
</script>

}