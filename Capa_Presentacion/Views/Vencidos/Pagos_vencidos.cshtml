@using System.Text.Json
@model List<Capa_Entidad.Vencido>

@{
    ViewData["Title"] = "Pago de Vencidos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


@{
    var jsonAcciones = Context.Session.GetString("AccionesUsuario");
    var acciones = !string.IsNullOrEmpty(jsonAcciones)
        ? JsonSerializer.Deserialize<List<string>>(jsonAcciones)
        : new List<string>();

    bool puedepagarmenos = acciones.Contains("Permitir_Pago_Menor");
}

<ol class="breadcrumb mb-4 mt-4">
    <li class="breadcrumb-item">
        <a asp-controller="Home" asp-action="Bienvenido">Inicio</a>
    </li>
    <li class="breadcrumb-item active">Pago de Vencidos</li>
</ol>

<div class="card shadow border-0">
    <div class="card-header text-white" style="background-color:#274DF5;">
        <i class="fas fa-exclamation-circle me-2"></i> Registrar Pago de Vencidos
    </div>

    <div class="card-body">

        <!-- PROVEEDOR -->
        <div class="row mb-3">
            <div class="col-md-4">
                <label>Proveedor</label>
                <div class="input-group">
                    <input type="text" id="txtProveedorSeleccionado"
                           class="form-control"
                           placeholder="-- Seleccione --"
                           readonly>
                    <button class="btn btn-primary" type="button" id="btnAbrirModalProveedor">
                        <i class="fas fa-search"></i>
                    </button>
                </div>
                <input type="hidden" id="cmbProveedor">
            </div>
        </div>

        <!-- TABLA DE VENCIDOS -->
        <table class="table table-striped" id="tablaVencidos">
            <thead class="bg-primary text-white">
                <tr>
                    <th>@*<input type="checkbox" id="chkTodos" />*@</th>
                    <th>Número Orden</th>
                    <th>Concepto</th>
                    <th>Fecha Creación</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>

        <button id="btnPagar" class="btn btn-success mt-2">
            <i class="fas fa-check"></i> Registrar Pago
        </button>
    </div>
</div>

<!-- MODAL PROVEEDORES -->
<div class="modal fade" id="modalProveedores" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Seleccionar Proveedor</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="text" id="txtBuscarProveedor"
                       class="form-control mb-2"
                       placeholder="Buscar proveedor...">
                <table class="table table-hover" id="tablaModalProveedores">
                    <thead>
                        <tr>
                            <th>Proveedor</th>
                            <th>Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Select(x => x.Proveedor).Distinct())
                        {
                            <tr>
                                <td>@p</td>
                                <td>
                                    <button class="btn btn-sm btn-success btnSeleccionarProveedor"
                                            data-nombre="@p">
                                        Seleccionar
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- MODAL DE PAGO -->
<div class="modal fade" id="modalPago" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">

            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Datos del Pago</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <h6 class="fw-bold text-primary">Vencido Seleccionado</h6>

                <div class="table-responsive mb-3">
                    <table class="table table-sm table-bordered" id="tablaVencidosSeleccionados">
                        <thead class="table-primary text-center">
                            <tr>
                                <th>Número Orden</th>
                                <th>Concepto</th>
                                <th>Fecha Creación</th>
                                <th class="text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>

                <div class="alert alert-success d-flex justify-content-between align-items-center">
                    <strong>Total a Pagar</strong>
                    <span id="lblTotal" class="fs-4 fw-bold" data-total="0">C$0.00</span>
                </div>


                <hr>

                <!-- =========================================
                🔹 RETENCIONES
                ========================================= -->
                <h6 class="fw-bold text-danger">
                    <i class="fas fa-percentage me-1"></i> Retenciones
                </h6>

                <div class="row mb-2">
                    <div class="col-md-6">
                        <select id="cmbRetenciones" class="form-control">
                            <option value="">-- Seleccionar retención --</option>
                        </select>
                    </div>
                </div>

                <div id="contenedorRetenciones" class="mb-2"></div>

                <div class="alert alert-warning d-flex justify-content-between">
                    <strong>Total Retenciones</strong>
                    <span id="lblTotalRetenciones" data-total="0">C$0.00</span>
                </div>

                <div class="alert alert-primary d-flex justify-content-between">
                    <strong>Total Neto a Pagar</strong>
                    <span id="lblTotalNeto" data-total="0">C$0.00</span>
                </div>

                @if (puedepagarmenos)
                {
                    <div class="form-check mt-2">
                        <input class="form-check-input" type="checkbox" id="chkPermitirPagoMenor">
                        <label class="form-check-label text-danger fw-bold">
                            Permitir registrar pago menor al neto
                        </label>
                    </div>

                }


                <hr>

                <h6 class="fw-bold text-secondary">
                    <i class="fas fa-file-invoice-dollar me-1"></i> Forma de Pago
                </h6>

                <table class="table" id="tablaPagosTipos">
                    <thead>
                        <tr>
                            <th>Tipo Documento</th>
                            <th>Monto</th>
                            <th>N° Confirmación</th>
                            <th>Comprobante</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>

                <div class="row mb-3">
                    <div class="col-md-3">
                        <select id="cmbTipoDocAgregar" class="form-control">
                            <option value="">-- Seleccione Tipo --</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <input type="number" id="txtMontoAgregar" class="form-control" placeholder="Monto">
                    </div>
                    <div class="col-md-3">
                        <input type="text" id="txtNumeroConfirmacionAgregar" class="form-control" placeholder="N° Confirmación">
                    </div>
                    <div class="col-md-3">
                        <input type="file" id="fileComprobanteAgregar" class="form-control" accept=".jpg,.jpeg,.png,.pdf">
                    </div>
                    <div class="col-md-12 mt-2">
                        <button id="btnAgregarPago" class="btn btn-primary">Agregar Pago</button>
                    </div>
                </div>

                <label>Observación</label>
                <textarea id="txtObs" class="form-control"></textarea>

            </div>

            <div class="modal-footer">
                <button id="btnConfirmarPago" class="btn btn-success">Confirmar Pago</button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL MENSAJE -->
<div class="modal fade" id="modalMensaje" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Mensaje</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="modalBody"></div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL ÉXITO -->
<div class="modal fade" id="modalExito" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">Pago Registrado</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>El pago se registró correctamente.</p>
                <p><strong>Número de Documento:</strong> <span id="lblNumeroDoc"></span></p>
            </div>
        </div>
    </div>
</div>

@section scripts {
<script>
    const todosVencidos = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        Model.Select(x => new {
            x.IdVencido,
            x.NumeroOrden,
            x.Concepto,
            x.Proveedor,
            FechaCreacion = x.FechaCreacion.ToString("yyyy-MM-dd"),
            x.Total
        })
    ));

    let pagosTipos = [];

    function fMonto(m) { return m.toLocaleString('es-NI', { style: 'currency', currency: 'NIO' }); }
    function mostrarModal(msg) { $('#modalBody').text(msg); new bootstrap.Modal(document.getElementById('modalMensaje')).show(); }

    // Abrir modal proveedores
    $('#btnAbrirModalProveedor').click(() => new bootstrap.Modal(document.getElementById('modalProveedores')).show());

    // Seleccionar proveedor
    $(document).on('click', '.btnSeleccionarProveedor', function() {
        let prov = $(this).data('nombre');
        $('#txtProveedorSeleccionado').val(prov);
        $('#cmbProveedor').val(prov).trigger('change');
        bootstrap.Modal.getInstance(document.getElementById('modalProveedores')).hide();
    });

    // Buscar proveedor
    $('#txtBuscarProveedor').on('keyup', function() {
        let texto = $(this).val().toLowerCase();
        $('#tablaModalProveedores tbody tr').each(function() {
            let nombre = $(this).find('td:first').text().toLowerCase();
            $(this).toggle(nombre.includes(texto));
        });
    });

    function editarPago(index) {

        let pago = pagosTipos[index];

        // Cargar datos en inputs
        $('#cmbTipoDocAgregar').val(pago.id);
        $('#txtMontoAgregar').val(pago.monto);
        $('#txtNumeroConfirmacionAgregar').val(pago.numeroConfirmacion);

        // Guardamos índice en edición
        $('#btnAgregarPago').data('editando', index);

        // Opcional: cambiar texto botón
        $('#btnAgregarPago').text('Actualizar Pago');
    }


    // ============================================
    // RETENCIONES
    // ============================================

    // Cargar retenciones
      $.get('/TipoRetencion/Listar', function (res) {

          listaRetenciones = res;

          let cmb = $('#cmbRetenciones');
          cmb.empty().append('<option value="">-- Seleccionar retención --</option>');

          res.forEach(r => {
                  cmb.append(`<option value="${r.id}" data-porcentaje="${r.porcentaje}">
                  ${r.nombre} (${r.porcentaje}%)
             </option>`);
          });

      });

      $('#cmbRetenciones').change(function () {

          let id = $(this).val();
          if (!id) return;

          let option = $(this).find('option:selected');
          let nombre = option.text();
          let porcentaje = option.data('porcentaje');

          $('#contenedorRetenciones').append(`
                <div class="form-check retencion-item" data-id="${id}">
                    <input class="form-check-input chkRetencion"
                           type="checkbox"
                           checked
                           data-id="${id}"
                           data-porcentaje="${porcentaje}">

                    <label class="form-check-label">
                        ${nombre}
                    </label>
                </div>
            `);

          // eliminar del combo
          option.remove();

          $('#cmbRetenciones').val('');

          calcularRetenciones();

      });

      $(document).on('change', '.chkRetencion', function () {

          if (!$(this).is(':checked')) {

              let cont = $(this).closest('.retencion-item');

              let id = $(this).data('id');
              let porcentaje = $(this).data('porcentaje');
              let nombre = cont.find('label').text();

              $('#cmbRetenciones').append(`
                <option value="${id}" data-porcentaje="${porcentaje}">
                    ${nombre}
                </option>
              `);

              cont.remove();
          }

          calcularRetenciones();
      });

    // Evento cambio de retenciones
    $(document).on('change', '.chkRetencion', function () {
        calcularRetenciones();
    });

    // Cálculo de retenciones
    function calcularRetenciones() {

        let total = parseFloat($('#lblTotal').data('total')) || 0;
        let totalRetenciones = 0;

        $('.chkRetencion:checked').each(function () {
            let porcentaje = parseFloat($(this).data('porcentaje'));
            totalRetenciones += total * (porcentaje / 100);
        });

        let totalNeto = total - totalRetenciones;

        $('#lblTotalRetenciones')
            .data('total', totalRetenciones)
            .text(fMonto(totalRetenciones));

        $('#lblTotalNeto')
            .data('total', totalNeto)
            .text(fMonto(totalNeto));
    }

    // Cargar vencidos según proveedor
    $('#cmbProveedor').change(function() {
        let prov = $(this).val();
        let tbody = $('#tablaVencidos tbody');
        tbody.empty();
        $('#chkTodos').prop('checked', false);
        if (!prov) return;

        todosVencidos.filter(x => x.Proveedor === prov)
            .forEach(v => {
                tbody.append(`
                    <tr>
                        <td><input type="checkbox" class="chkVencido" value="${v.IdVencido}" data-total="${v.Total}" /></td>
                        <td>${v.NumeroOrden}</td>
                        <td>${v.Concepto}</td>
                        <td>${v.FechaCreacion}</td>
                        <td>${fMonto(v.Total)}</td>
                    </tr>
                `);
            });
    });

    $('#chkTodos').on('change', function(){ $('.chkVencido').prop('checked', this.checked); });

    // Bloquear selección múltiple
    $(document).on('change', '.chkVencido', function() {
        if ($(this).is(':checked')) $('.chkVencido').not(this).prop('checked', false);
    });

    // Botón Pagar
    $('#btnPagar').click(function() {
        let sel = $('.chkVencido:checked');
        if (sel.length === 0) return mostrarModal('Seleccione un vencido');

        let tbody = $('#tablaVencidosSeleccionados tbody').empty();
        let total = 0;

        sel.each(function() {
            let fila = $(this).closest('tr');
            let monto = parseFloat($(this).data('total'));
            total += monto;
            tbody.append(`
                <tr>
                    <td>${fila.find('td:eq(1)').text()}</td>
                    <td>${fila.find('td:eq(2)').text()}</td>
                    <td>${fila.find('td:eq(3)').text()}</td>
                    <td class="text-end">${fMonto(monto)}</td>
                </tr>
            `);
        });

        $('#lblTotal').text(fMonto(total)).data('total', total);

        calcularRetenciones();

        // Cargar tipos de documento
        $.get('/TipoDocumentoPago/ListarTipos', function(res) {
            $('#cmbTipoDocAgregar').empty().append('<option value="">-- Seleccione Tipo --</option>');
            res.forEach(t => $('#cmbTipoDocAgregar').append(`<option value="${t.id}">${t.nombre}</option>`));
        });

        new bootstrap.Modal(document.getElementById('modalPago')).show();
    });

    // Agregar pago
    $('#btnAgregarPago').click(function () {

        let tipoId = $('#cmbTipoDocAgregar').val();
        let tipoNombre = $('#cmbTipoDocAgregar option:selected').text();
        let monto = parseFloat($('#txtMontoAgregar').val());
        let numeroConfirmacion = $('#txtNumeroConfirmacionAgregar').val();
        let file = $('#fileComprobanteAgregar')[0].files[0];

        let editandoIndex = $('#btnAgregarPago').data('editando');

        if (!tipoId || !monto || monto <= 0)
            return mostrarModal('Seleccione tipo y monto válido');

        if (!numeroConfirmacion)
            return mostrarModal('Ingrese N° de Confirmación');

        // SI ES EDICIÓN
        if (editandoIndex !== undefined) {

            let pagoExistente = pagosTipos[editandoIndex];

            pagosTipos[editandoIndex] = {
                id: parseInt(tipoId),
                nombre: tipoNombre,
                monto: monto,
                numeroConfirmacion: numeroConfirmacion,
                file: file ? file : pagoExistente.file // conserva archivo si no cambian
            };

            $('#btnAgregarPago').removeData('editando');
            $('#btnAgregarPago').text('Agregar Pago');

        }
        else {

            if (!file)
                return mostrarModal('Debe seleccionar un comprobante');

            pagosTipos.push({
                id: parseInt(tipoId),
                nombre: tipoNombre,
                monto: monto,
                numeroConfirmacion: numeroConfirmacion,
                file: file
            });
        }

        actualizarTablaPagos();

        $('#cmbTipoDocAgregar').val('');
        $('#txtMontoAgregar').val('');
        $('#txtNumeroConfirmacionAgregar').val('');
        $('#fileComprobanteAgregar').val('');

    });

    function actualizarTablaPagos() {

        let tbody = $('#tablaPagosTipos tbody');
        tbody.empty();

        pagosTipos.forEach((p, i) => {

            let tieneArchivo = p.file != null;

            tbody.append(`
        <tr>
            <td>${p.nombre}</td>
            <td>${fMonto(p.monto)}</td>
            <td>${p.numeroConfirmacion}</td>

            <td>
                ${tieneArchivo
                    ? `<button class="btn btn-sm btn-info" onclick="verArchivo(${i})">
                        <i class="fas fa-eye"></i>
                   </button>`
                    : `<span class="text-muted">Sin archivo</span>`
                }
            </td>

            <td>
                <button class="btn btn-warning btn-sm" onclick="editarPago(${i})">
                    <i class="fas fa-edit"></i>
                </button>

                <button class="btn btn-danger btn-sm" onclick="eliminarPago(${i})">
                    <i class="fas fa-trash"></i>
                </button>
            </td>
        </tr>
        `);

        });
    }

    function verArchivo(index) {

        let file = pagosTipos[index].file;

        if (!file) {
            mostrarModal('No hay archivo disponible');
            return;
        }

        let url = URL.createObjectURL(file);
        window.open(url, '_blank');
    }

    // Eliminar pago
    function eliminarPago(i) {
        pagosTipos.splice(i, 1);
        actualizarTablaPagos();
    }
     // Confirmar pago
    $('#btnConfirmarPago').click(function () {

    let vencidoSeleccionado = $('.chkVencido:checked');

    if (vencidoSeleccionado.length !== 1) {
        mostrarModal('Debe seleccionar un solo vencido');
        return;
    }

    let idVencido = parseInt(vencidoSeleccionado.val());

    if (isNaN(idVencido)) {
        mostrarModal('Id del vencido inválido');
        return;
    }

    if (pagosTipos.length === 0) {
        mostrarModal('Agregue al menos un pago');
        return;
    }

    // =========================================
    // TOTALES
    // =========================================

    let totalVencido = parseFloat($('#lblTotal').data('total')) || 0;
    let totalRetenciones = parseFloat($('#lblTotalRetenciones').data('total')) || 0;

    // dinero real pagado
    let totalPagos = pagosTipos.reduce((s, x) => s + parseFloat(x.monto), 0);

    // total aplicado (pagos + retenciones)
    let totalAplicado = totalPagos + totalRetenciones;

    // =========================================
    // VALIDACIÓN
    // =========================================

        let totalNeto = parseFloat($('#lblTotalNeto').data('total')) || 0;
        let permitirPagoMenor = $('#chkPermitirPagoMenor').is(':checked');

        // 🔥 VALIDACIÓN FINANCIERA
        if (totalPagos < totalNeto && !permitirPagoMenor) {

            mostrarModal(
                'El monto pagado no puede ser menor al total neto. ' +
                'Active la opción "Permitir pago menor" si tiene autorización.'
            );

            return;
        }

    // =========================================
    // GENERAR DETALLE
    // =========================================

    let usuarioActual = '@ViewBag.UsuarioActual';

    let detalleEnvio = pagosTipos.map(p => ({
        IdVencido: idVencido,
        MontoPagado: parseFloat(p.monto),
        IdTipoDocumento: p.id,
        NumeroConfirmacion: p.numeroConfirmacion,
        RutaComprobante: p.file ? p.file.name : null,
        UsuarioPago: usuarioActual
    }));

    // =========================================
    // RETENCIONES
    // =========================================

    let retenciones = [];

    $('.chkRetencion:checked').each(function () {

        let porcentaje = parseFloat($(this).data('porcentaje'));
        let id = parseInt($(this).data('id'));

        let monto = +(totalVencido * (porcentaje / 100)).toFixed(2);

        retenciones.push({
            IdTipoRetencion: id,
            Porcentaje: porcentaje,
            MontoRetenido: monto
        });

    });

    // =========================================
    // FORM DATA
    // =========================================

    let formData = new FormData();

    formData.append('IdVencido', idVencido);
    formData.append('Observacion', $('#txtObs').val());

    formData.append('DetallePagos', JSON.stringify(detalleEnvio));

    // 🔥 TOTAL REAL APLICADO
    formData.append('TotalAPagar', totalAplicado);

    formData.append('Retenciones', JSON.stringify(retenciones));

    // comprobantes
    pagosTipos.forEach((p, i) => {
        if (p.file) {
            formData.append(`PagosTipos[${i}].Comprobante`, p.file);
        }
    });

    // =========================================
    // AJAX
    // =========================================

    $.ajax({
        url: '/Vencidos/RegistrarPagoMultiples',
        type: 'POST',
        data: formData,
        processData: false,
        contentType: false,

        success: function (r) {

            if (r.success) {

                $('#lblNumeroDoc').text(r.numeroDocumento);

                new bootstrap.Modal(
                    document.getElementById('modalExito')
                ).show();

                setTimeout(() => location.reload(), 3000);

            } else {

                mostrarModal(r.mensajes.join('\n'));

            }
        },

        error: function () {
            mostrarModal('Error al registrar el pago');
        }

    });

});
    </script>
}
