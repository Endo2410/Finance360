@{
    ViewData["Title"] = "Cheques";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="text-dark">Gestión de Cheques</h3>
    <button type="button" class="btn btn-primary" onclick="abrirModal()">
        <i class="fas fa-plus"></i> Registrar Nuevo Cheque
    </button>
</div>

<div class="card shadow">
    <div class="card-header bg-dark text-white d-flex justify-content-between">
        <span><i class="fas fa-money-check-alt"></i> Historial de Cheques</span>
    </div>
    <div class="card-body">
        <table id="tablaCheques" class="table table-hover table-bordered w-100">
            <thead class="table-light">
                <tr>
                    <th>N° Cheque</th>
                    <th>Concepto</th>
                    <th>Monto</th>
                    <th>Fecha</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="modalRegistro" tabindex="-1" data-bs-backdrop="static" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title"><i class="fas fa-edit"></i> Formulario de Cheque</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="formCheque" enctype="multipart/form-data">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">N° Cheque</label>
                            <input type="number" class="form-control" name="numero" placeholder="Ej: 2111" required>
                        </div>
     
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Monto (C$)</label>
                            <input type="text" class="form-control monto-input" id="txtMontoCheque" name="entrada"
                                   placeholder="0.00" required>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label fw-bold">Foto del Cheque (Evidencia)</label>
                            <input type="file" class="form-control" id="txtFoto" name="fotoCheque" accept="image/*" onchange="previsualizarImagen(this)">
                        </div>

                        <div class="col-md-12 text-center" id="contenedorPreview" style="display:none;">
                            <label class="form-label d-block fw-bold text-muted">Vista previa seleccionada:</label>
                            <img id="imgPreview" src="#" alt="Vista previa" class="img-thumbnail shadow-sm" style="max-height: 200px;">
                        </div>

                        <div class="col-md-12">
                            <label class="form-label fw-bold">Concepto / Detalle</label>
                            <textarea class="form-control" name="concepto" rows="3" placeholder="Escriba el motivo del cheque..."></textarea>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" onclick="Guardar()">
                    <i class="fas fa-save"></i> Guardar Registro
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalFoto" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Vista Previa de Imagen</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center bg-light">
                <img id="imgCheque" src="" class="img-fluid rounded shadow" alt="Foto del cheque">
            </div>
        </div>
    </div>
</div>

@section scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.2.2/css/buttons.bootstrap5.min.css" />

    <script src="https://cdn.datatables.net/buttons/2.2.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.2.2/js/buttons.bootstrap5.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.1.3/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.2.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.2.2/js/buttons.print.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        var tablaData;

        $(document).ready(function () {
       
            // Esta función sirve para CUALQUIER input que tenga la clase .monto-input
            $(document).on("keyup", ".monto-input", function (event) {
                if (event.which >= 37 && event.which <= 40) return;

                $(this).val(function (index, value) {
                    return value
                        .replace(/\D/g, "") // Quita letras
                        .replace(/([0-9])([0-9]{2})$/, '$1.$2') // Pone decimales
                        .replace(/\B(?=(\d{3})+(?!\d))/g, ","); // Pone comas de miles
                });
            });

            // Limpiar al entrar
            $(document).on("focus", ".monto-input", function () {
                if ($(this).val() == "0.00" || $(this).val() == "0") {
                    $(this).val("");
                }
            });

            // Restaurar si sale vacío
            $(document).on("blur", ".monto-input", function () {
                if ($(this).val() == "") {
                    $(this).val("0.00");
                }
            });
            tablaData = $('#tablaCheques').DataTable({
                responsive: true,
                "ajax": {
                    "url": '@Url.Action("ListarCheques", "CajaChica")',
                    "type": "GET",
                    "datatype": "json"
                },
                "columns": [
                    { "data": "numeroCheque" },
                    { "data": "concepto" },
                    {
                        "data": "entrada",
                        "render": function(data) {
                            return "<b>C$ " + parseFloat(data).toLocaleString('en-US', {minimumFractionDigits: 2}) + "</b>";
                        }
                    },
                    {
                        "data": "fechaRegistro",
                        "render": function(data) {
                            return new Date(data).toLocaleDateString();
                        }
                    },
                    {
                        "data": "foto",
                        "className": "text-center",
                        "render": function (data) {
                            if (data) {
                                return `<button class="btn btn-outline-info btn-sm" onclick="verFoto('${data}')">
                                            <i class="fas fa-eye"></i> Ver Foto
                                        </button>`;
                            }
                            return '<span class="badge bg-secondary">Sin foto</span>';
                        },
                        "orderable": false
                    }
                ],
                "language": {
                    "url": "https://cdn.datatables.net/plug-ins/1.11.3/i18n/es_es.json"
                }
            });
        });

        // NUEVA FUNCIÓN: PREVISUALIZAR ANTES DE SUBIR
        function previsualizarImagen(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    $('#imgPreview').attr('src', e.target.result);
                    $('#contenedorPreview').fadeIn(); // Muestra la imagen suavemente
                }
                reader.readAsDataURL(input.files[0]);
            } else {
                $('#contenedorPreview').hide();
            }
        }

        function abrirModal() {
            $("#formCheque")[0].reset();
            $('#contenedorPreview').hide(); // Resetear preview
            $('#imgPreview').attr('src', '#');
            $("#montoAyuda").text(""); // <-- Limpiar el texto de ayuda
            $("#modalRegistro").modal("show");
        }

        function verFoto(base64) {
            $("#imgCheque").attr("src", "data:image/png;base64," + base64);
            $("#modalFoto").modal("show");
        }

        function Guardar() {
                // 1. Validaciones
            if ($("input[name='numero']").val() == "" || $("#txtMontoCheque").val() == "0.00") {
                Swal.fire("Atención", "Número y Monto son obligatorios", "warning");
                return;
            }

            // 2. CREAR EL FORMDATA
            var formData = new FormData($('#formCheque')[0]);

            // 3. LIMPIAR EL MONTO (Quitar comas antes de enviar)
            // Obtenemos el valor del input, le quitamos las comas
            let montoLimpio = $("#txtMontoCheque").val().replace(/,/g, "");
            // Lo sobreescribimos en el FormData para que al controlador llegue como un número decimal puro
            formData.set("entrada", montoLimpio);

            $.ajax({
                url: '@Url.Action("GuardarCheque", "CajaChica")',
                type: "POST",
                data: formData, // Enviamos el formData con el monto ya limpio
                contentType: false,
                processData: false,
                success: function (data) {
                            if (data.resultado) {
                                $("#modalRegistro").modal("hide");
                                Swal.fire("Éxito", data.mensaje, "success");
                                tablaData.ajax.reload();
                            } else {
                                Swal.fire("Atención", data.mensaje, "warning");
                            }
                },
                        error: function () {
                            Swal.fire("Error", "Ocurrió un error en el servidor", "error");
               }
            });
        }
    </script>
}