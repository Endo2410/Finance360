                                        <a class="nav-link" asp-controller="Publicidad" asp-action="Index">Campañas </a>
                                    }
                                    @if (permisos.Any(p => p.oSubMenu != null && p.oSubMenu.NombreSubMenu == "Estado_Cuenta"))
                                    {
                                        <a class="nav-link" asp-controller="EstadoCuenta" asp-action="Index">Estado de Cuenta </a>
                                    }
                                    @if (permisos.Any(p => p.oSubMenu != null && p.oSubMenu.NombreSubMenu == "Pago_Publicidad"))
                                    {
                                        <a class="nav-link" asp-controller="PagoPublicidad" asp-action="Index">Pago de Campañas </a>
