                        <!--Caja Chica -->
                        @if (permisos.Any(p => p.oModulo.NombreModulo == "Caja_Chica"))
                        {
                            <a class="nav-link collapsed" href="#" data-bs-toggle="collapse" data-bs-target="#collapseCajaChica" aria-expanded="false">
