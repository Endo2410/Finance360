                                    {
                                        <a class="nav-link" asp-controller="Vencidos" asp-action="Pagos_vencidos">Pagos de Vencidos</a>
                                    }
                                </nav>
                            </div>
                        }

                        <!-- CANJE -->
                        @if (permisos.Any(p => p.oModulo.NombreModulo == "Canje"))
                        {
                            <a class="nav-link collapsed" href="#" data-bs-toggle="collapse" data-bs-target="#collapseCanje" aria-expanded="false">
