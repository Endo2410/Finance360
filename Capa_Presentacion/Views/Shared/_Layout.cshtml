                            <div class="collapse" id="collapseNotaCredito" data-bs-parent="#sidenavAccordion">
                                <nav class="sb-sidenav-menu-nested nav">
                                    @if (permisos.Any(p => p.oSubMenu != null && p.oSubMenu.NombreSubMenu == "Nota_Credito"))
                                    {
                                        <a class="nav-link" asp-controller="NotaCredito" asp-action="Index">Notas </a>
                                    }
                                    @if (permisos.Any(p => p.oSubMenu != null && p.oSubMenu.NombreSubMenu == "Aplicacion_Credito"))
                                    {
                                        <a class="nav-link" asp-controller="PagoNC" asp-action="Index">Procesar </a>
                                    }
                                </nav>
                            </div>
                        }


                        @*  <!-- ALERTA -->
        <a class="nav-link collapsed" href="#" data-bs-toggle="collapse" data-bs-target="#collapseAlerta" aria-expanded="false">
            <div class="sb-nav-link-icon">
                <i class="fas fa-bell me-2"></i>
            </div>
            Alertas
            <div class="sb-sidenav-collapse-arrow">
                <i class="fas fa-angle-down"></i>
            </div>
        </a>

        <div class="collapse" id="collapseAlerta" data-bs-parent="#sidenavAccordion">
            <nav class="sb-sidenav-menu-nested nav">

                <a class="nav-link" asp-controller="Alerta" asp-action="Index">
