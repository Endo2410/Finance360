                                Canje
                                <div class="sb-sidenav-collapse-arrow"><i class="fas fa-angle-down"></i></div>
                            </a>
                            <div class="collapse" id="collapseCanje" data-bs-parent="#sidenavAccordion">
                                <nav class="sb-sidenav-menu-nested nav">
                                    @if (permisos.Any(p => p.oSubMenu != null && p.oSubMenu.NombreSubMenu == "Canje"))
                                    {
                                        <a class="nav-link" asp-controller="Canje" asp-action="Index">Canje </a>
                                    }
                                    @if (permisos.Any(p => p.oSubMenu != null && p.oSubMenu.NombreSubMenu == "Lista_Pago_Canje"))
                                    {
                                        <a class="nav-link" asp-controller="Canje" asp-action="ListaPagos">Lista de Pago</a>
                                    }
                                    @if (permisos.Any(p => p.oSubMenu != null && p.oSubMenu.NombreSubMenu == "Pago_Canje"))
                                    {
                                        <a class="nav-link" asp-controller="PagoCanje" asp-action="Index">Pagos de Canjes</a>
                                    }
                                </nav>
                            </div>
                        }

                        <!-- Nota de credito -->
                        @if (permisos.Any(p => p.oModulo.NombreModulo == "Nota_Credito"))
                        {
                            <a class="nav-link collapsed" href="#" data-bs-toggle="collapse" data-bs-target="#collapseNotaCredito" aria-expanded="false">
