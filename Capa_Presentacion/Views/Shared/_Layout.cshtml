    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="~/js/scripts.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/js/all.min.js" crossorigin="anonymous"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>

<script>
    function cargarAlertas() {
        $.get('/Alerta/ObtenerAlertas', function (data) {

            let html = '';

            if (data.length === 0) {
                html = '<li><span class="dropdown-item text-center">Sin alertas</span></li>';
            } else {

                data.forEach(a => {

                    let estilo = a.vista ? '' : 'fw-bold';

                    html += `
                        <li>
                            <span class="dropdown-item ${estilo}">
                                ${a.mensaje}
                                <br/>
                                <small>${new Date(a.fechaAlerta).toLocaleString()}</small>
                            </span>
                        </li>`;
                });
                html += `<li><hr/></li>
                         <li>
                            <a class="dropdown-item text-center" href="#" onclick="marcarVistas()">
                                Marcar todas como vistas
                            </a>
                         </li>`;
            }

            $('#listaAlertas').html(html);
        });
    }

    document.addEventListener('DOMContentLoaded', function () {

        const sidebarToggle = document.getElementById('sidebarToggle');

        if (sidebarToggle) {
            sidebarToggle.addEventListener('click', function (e) {
                e.preventDefault();

                document.body.classList.toggle('sb-sidenav-toggled');
            });
        }
    });

    function contarAlertas() {
        $.get('/Alerta/ContarAlertas', function (data) {
            $('#badgeAlertas').text(data.total);
        });
    }

    function marcarVistas() {
        $.post('/Alerta/MarcarVistas', function () {
            cargarAlertas();
            contarAlertas();
        });
    }

    // 🔥 Al cargar la página
    $(document).ready(function () {
        contarAlertas();
        cargarAlertas();
    });
</script>