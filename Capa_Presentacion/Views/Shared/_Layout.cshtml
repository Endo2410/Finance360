                                    {
                                        <a class="nav-link" asp-controller="CajaChica" asp-action="Movimientos">Movimientos </a>
                                    }
                                    @if (permisos.Any(p => p.oSubMenu != null && p.oSubMenu.NombreSubMenu == "Cheques"))
                                    {
                                        <a class="nav-link" asp-controller="CajaChica" asp-action="Cheques">Cheques </a>
                                    }
