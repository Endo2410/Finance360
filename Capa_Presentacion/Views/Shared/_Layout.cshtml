                        <!-- INCENTIVO -->
                        @if (permisos.Any(p => p.oModulo.NombreModulo == "Incentivo"))
                        {
                            <a class="nav-link collapsed" href="#" data-bs-toggle="collapse" data-bs-target="#collapseIncentivo" aria-expanded="false">
                                <div class="sb-nav-link-icon"> <i class="fas fa-gift me-2"></i>  </div>
                                Incentivos
                                <div class="sb-sidenav-collapse-arrow"> <i class="fas fa-angle-down"></i>  </div>
                            </a>

                            <div class="collapse" id="collapseIncentivo" data-bs-parent="#sidenavAccordion">
