                    <div class="nav">
                        <div class="sb-sidenav-menu-heading">Módulos Principales</div>

                        <!--Dashboard -->
                        @if (permisos.Any(p => p.oModulo != null && p.oModulo.NombreModulo == "Dashboard"))
                        {
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                                <div class="sb-nav-link-icon"><i class="fas fa-tachometer-alt"></i></div>
                                Dashboard
                            </a>
                        }


                        <!--Seguridad -->
                        @if (permisos.Any(p => p.oModulo != null && p.oModulo.NombreModulo == "Seguridad"))
                        {
                            <a class="nav-link collapsed" href="#" data-bs-toggle="collapse" data-bs-target="#collapseUsuarios">
                                <div class="sb-nav-link-icon"><i class="fas fa-users-cog"></i></div>
                                Seguridad
                                <div class="sb-sidenav-collapse-arrow"><i class="fas fa-angle-down"></i></div>
                            </a>

                            <div class="collapse" id="collapseUsuarios">
                                <nav class="sb-sidenav-menu-nested nav">

                                    @if (permisos.Any(p => p.oSubMenu != null && p.oSubMenu.NombreSubMenu == "Usuarios"))
                                    {
                                        <a class="nav-link" asp-controller="Usuarios" asp-action="Index">Usuarios</a>
                                    }

                                    @if (permisos.Any(p => p.oSubMenu != null && p.oSubMenu.NombreSubMenu == "Rol"))
                                    {
                                        <a class="nav-link" asp-controller="Rol" asp-action="Index">Rol</a>
                                    }

                                    @if (permisos.Any(p => p.oSubMenu != null && p.oSubMenu.NombreSubMenu == "Asignar Permisos"))
                                    {
                                        <a class="nav-link" asp-controller="Permiso" asp-action="Index">Asignar Permisos</a>
                                    }
                                </nav>
                            </div>
                        }

                        <!-- Catálogos -->
                        @if (permisos.Any(p => p.oModulo != null && p.oModulo.NombreModulo == "Catalogo"))
                        {
                            <a class="nav-link collapsed" href="#" data-bs-toggle="collapse" data-bs-target="#collapseCatalogos" aria-expanded="false">
                                <div class="sb-nav-link-icon"><i class="fas fa-book"></i></div>
                                Catálogos
                                <div class="sb-sidenav-collapse-arrow"><i class="fas fa-angle-down"></i></div>
                            </a>
                            <div class="collapse" id="collapseCatalogos" data-bs-parent="#sidenavAccordion">
                                <nav class="sb-sidenav-menu-nested nav">
                                    @if (permisos.Any(p => p.oSubMenu != null && p.oSubMenu.NombreSubMenu == "Proveedores"))
                                    {
                                        <a class="nav-link" asp-controller="Proveedores" asp-action="Gestión">Gestión General</a>
                                    }
                                    @if (permisos.Any(p => p.oSubMenu != null && p.oSubMenu.NombreSubMenu == "Pais"))
                                    {
                                        <a class="nav-link" asp-controller="Pais" asp-action="Index">Pais</a>
                                    }
                                    @if (permisos.Any(p => p.oSubMenu != null && p.oSubMenu.NombreSubMenu == "Moneda"))
                                    {
                                        <a class="nav-link" asp-controller="Moneda" asp-action="Index">Moneda</a>
                                    }
                                    @if (permisos.Any(p => p.oSubMenu != null && p.oSubMenu.NombreSubMenu == "Tipo_Publicidad"))
                                    {
                                        <a class="nav-link" asp-controller="TipoPublicidad" asp-action="Tipos">Gestion de Tipos</a>
                                    }
                                    @if (permisos.Any(p => p.oSubMenu != null && p.oSubMenu.NombreSubMenu == "Gestion_Incentivo"))
                                    {
                                        <a class="nav-link" asp-controller="Incentivo" asp-action="GestionIncentivo">Gestion Incentivo</a>
                                    }
                                </nav>
                            </div>
                        }

                        <!-- Orden Compra -->
