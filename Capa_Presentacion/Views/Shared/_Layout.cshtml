                                    @if (permisos.Any(p => p.oSubMenu != null && p.oSubMenu.NombreSubMenu == "Acuerdo_Rebate"))
                                    {
                                        <a class="nav-link" asp-controller="Rebate" asp-action="Acuerdo_Rebate">Acuerdo Rebate </a>
                                    }
                                    @if (permisos.Any(p => p.oSubMenu != null && p.oSubMenu.NombreSubMenu == "Ejecucion_Rebate"))
                                    {
                                        <a class="nav-link" asp-controller="Rebate" asp-action="Gestion_Ejecuciones">Gestion de Ejecuciones </a>
                                    }
                                    @if (permisos.Any(p => p.oSubMenu != null && p.oSubMenu.NombreSubMenu == "Pago_Rebate"))
                                    {
                                        <a class="nav-link" asp-controller="Rebate" asp-action="Pago_Rebate">Pago de Rebates </a>
