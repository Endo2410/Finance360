                                    @if (permisos.Any(p => p.oSubMenu != null && p.oSubMenu.NombreSubMenu == "Lista_Pago"))
                                    {
                                        <a class="nav-link" asp-controller="Publicidad" asp-action="ListaPagos">Lista de Pago </a>
                                    }
                                </nav>
                            </div>
                        }

                        <!-- Rebate -->
                        @if (permisos.Any(p => p.oModulo.NombreModulo == "Rebate"))
                        {
                            <a class="nav-link collapsed" href="#" data-bs-toggle="collapse" data-bs-target="#collapseRebate" aria-expanded="false">
