@using System.Text.Json
@model List<Capa_Entidad.Cuentas_Por_Pagar.TipoDescuentoPP>

@{
    ViewData["Title"] = "Gestión de Tipos de Descuento";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<br />
<br />

<!-- Breadcrumb -->
<ol class="breadcrumb mb-4 mt-4">
    <li class="breadcrumb-item">
        <a asp-controller="Home" asp-action="Bienevenido">Inicio</a>
    </li>
    <li class="breadcrumb-item active">Tipos de Descuento</li>
</ol>

<!-- Card principal -->
<div class="card shadow border-0">

    <div class="card-header text-white d-flex justify-content-between align-items-center"
         style="background-color:#274DF5;">
        <span>
            <i class="fas fa-percent me-2"></i>
            Lista de Tipos de Descuento
        </span>

        <button id="btnNuevo" class="btn btn-light btn-sm">
            <i class="fas fa-plus"></i> Nuevo Descuento
        </button>
    </div>

    <div class="card-body">

        <table class="table table-striped align-middle" id="tablaDescuentos">

            <thead class="text-white" style="background-color:#274DF5;">
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Porcentaje</th>
                    <th>Estado</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var m in Model)
                {
                    var json = JsonSerializer.Serialize(new
                    {
                        m.IdTipoDescuento,
                        m.Nombre,
                        m.Porcentaje,
                        IdEstado = m.oEstado?.IdEstado ?? 0
                    });

                    <tr>
                        <td>@m.IdTipoDescuento</td>
                        <td>@m.Nombre</td>
                        <td>@m.Porcentaje %</td>
                        <td>@m.oEstado?.Nombre</td>

                        <td class="text-center">
                            <button class="btn btn-warning btn-sm"
                                    onclick='abrirModal(@Html.Raw(json))'>
                                <i class="fas fa-edit"></i>
                            </button>
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>


<!-- Modal Crear / Editar -->

<div class="modal fade" id="modalDescuento" tabindex="-1" data-bs-backdrop="static">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Tipo de Descuento</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <form id="formDescuento" autocomplete="off">

                    <input type="hidden" id="txtid" value="0" />

                    <div class="mb-3">
                        <label class="form-label">Nombre</label>
                        <input id="txtnombre" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Porcentaje (%)</label>
                        <input id="txtporcentaje"
                               type="number"
                               step="0.01"
                               class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Estado</label>
                        <select id="cboestado" class="form-select"></select>
                    </div>

                    <div class="mt-3">
                        <div class="alert alert-danger d-none"
                             id="mensajeError"></div>
                    </div>

                </form>

            </div>

            <div class="modal-footer">

                <button class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancelar
                </button>

                <button class="btn btn-primary"
                        onclick="guardarDescuento()">
                    Guardar
                </button>

            </div>

        </div>

    </div>

</div>


<!-- Modal éxito -->

<div class="modal fade" id="modalExito" tabindex="-1">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">Éxito</h5>
                <button class="btn-close"
                        data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body" id="cuerpoExito"></div>

            <div class="modal-footer">
                <button class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cerrar
                </button>
            </div>

        </div>

    </div>

</div>


<!-- Modal error -->

<div class="modal fade" id="modalMensaje" tabindex="-1">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Error</h5>
                <button class="btn-close"
                        data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body" id="cuerpoMensaje"></div>

            <div class="modal-footer">
                <button class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cerrar
                </button>
            </div>

        </div>

    </div>

</div>


@section Scripts{

    <script>

$(document).ready(function () {

    cargarEstados();

    $('#btnNuevo').click(() => abrirModal());

});


function abrirModal(m = null) {

    $('#mensajeError').addClass('d-none').html('');

    $('#formDescuento')[0].reset();

    $('#txtid').val(m ? m.IdTipoDescuento : 0);

    if (m) {

        $('#txtnombre').val(m.Nombre);

        $('#txtporcentaje').val(m.Porcentaje);

        $('#cboestado').val(m.IdEstado);

    }

    new bootstrap.Modal('#modalDescuento').show();

}


function cargarEstados(){

    $.get('/TipoRetencion/Estado', function(data){

        $('#cboestado').empty();

        if(data.success){

            data.estados.forEach(e=>{

                $('#cboestado').append(
                    `<option value="${e.idEstado}">${e.nombre}</option>`
                )

            })

        }
        else{

            $('#cuerpoMensaje').html(data.mensajes.join('<br/>'))

            new bootstrap.Modal('#modalMensaje').show()

        }

    })

}


function guardarDescuento(){

    let obj = {

        IdTipoDescuento: $('#txtid').val(),

        Nombre: $('#txtnombre').val(),

        Porcentaje: parseFloat($('#txtporcentaje').val()),

        IdEstado: $('#cboestado').val()

    }


    let url = obj.IdTipoDescuento == 0
        ? '/TipoRetencion/CrearDescuento'
        : '/TipoRetencion/EditarDescuento'


    $.post(url,obj,function(res){

        $('#mensajeError').addClass('d-none').html('')

        if(res.success){

            bootstrap.Modal
            .getInstance(document.getElementById('modalDescuento'))
            .hide()

            $('#cuerpoExito').html(res.mensajes.join('<br/>'))

            new bootstrap.Modal('#modalExito').show()

            setTimeout(()=>location.reload(),1500)

        }
        else{

            let htmlErrores = res.mensajes
                .map(m=>`<p>${m}</p>`)
                .join('')

            $('#mensajeError')
                .removeClass('d-none')
                .html(htmlErrores)

        }

    }).fail(function(){

        $('#cuerpoMensaje').html('Error inesperado.')

        new bootstrap.Modal('#modalMensaje').show()

    })

}

    </script>

}