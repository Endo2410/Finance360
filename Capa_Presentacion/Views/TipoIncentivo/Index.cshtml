@using System.Text.Json
@model List<Capa_Entidad.TipoIncentivo>

@{
    ViewData["Title"] = "Gestión Tipo Incentivo";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="row">
    <!-- Publcidad -->
    <div class="col-md-3 mb-2">
        <a asp-controller="TipoPublicidad" asp-action="Index" class="text-decoration-none">
            <div class="card shadow h-100 border-0">
                <div class="card-body text-center">
                    <i class="fas fa-bullhorn fa-2x text-danger"></i>
                    <h6 class="mt-2">Tipo Publicidad</h6>
                </div>
            </div>
        </a>
    </div>

    <!-- Rebate -->
    <div class="col-md-2 mb-2">
        <a asp-controller="TipoRebate" asp-action="Index" class="text-decoration-none">
            <div class="card shadow h-100 border-0">
                <div class="card-body text-center">
                    <i class="fas fa-percentage fa-2x text-info"></i>
                    <h6 class="mt-2">Tipo Rebate</h6>
                </div>
            </div>
        </a>
    </div>

    <!-- Documento Pago -->
    <div class="col-md-2 mb-2">
        <a asp-controller="TipoDocumentoPago" asp-action="Index" class="text-decoration-none">
            <div class="card shadow h-100 border-0">
                <div class="card-body text-center">
                    <i class="fas fa-file-invoice fa-2x text-secondary"></i>
                    <h6 class="mt-2">Tipo Pago</h6>
                </div>
            </div>
        </a>
    </div>

    <!-- Incentivo -->
    <div class="col-md-2 mb-2">
        <a asp-controller="TipoIncentivo" asp-action="Index" class="text-decoration-none">
            <div class="card shadow h-100 border-0">
                <div class="card-body text-center">
                    <i class="fas fa-gift fa-2x text-primary"></i>
                    <h6 class="mt-2">Tipo Incentivo</h6>
                </div>
            </div>
        </a>
    </div>

    <!-- Uso incentivo -->
    <div class="col-md-3 mb-2">
        <a asp-controller="TipoIncentivo" asp-action="Tipouso" class="text-decoration-none">
            <div class="card shadow h-100 border-0">
                <div class="card-body text-center">
                    <i class="fas fa-tags fa-2x text-success"></i>
                    <h6 class="mt-2">Tipo Uso Incentivo</h6>
                </div>
            </div>
        </a>
    </div>
</div>


<!-- Breadcrumb -->
<ol class="breadcrumb mb-4 mt-4">
    <li class="breadcrumb-item">
        <a asp-controller="Home" asp-action="Index">Inicio</a>
    </li>
    <li class="breadcrumb-item active">Tipo Incentivo</li>
</ol>

<!-- Card principal -->
<div class="card shadow border-0">
    <div class="card-header text-white d-flex justify-content-between align-items-center"
         style="background-color:#274DF5;">
        <span>
            <i class="fas fa-gift me-2"></i>Lista Tipo Incentivo
        </span>
        <button id="btnNuevo" class="btn btn-light btn-sm">
            <i class="fas fa-plus"></i> Nuevo
        </button>
    </div>

    <div class="card-body">
        <table class="table table-striped align-middle">
            <thead class="text-white" style="background-color:#274DF5;">
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Estado</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model)
                {
                    var json = JsonSerializer.Serialize(new
                    {
                        t.IdTipoIncentivo,
                        t.Nombre,
                        IdEstado = t.oEstado?.IdEstado ?? 0
                    });

                    <tr>
                        <td>@t.IdTipoIncentivo</td>
                        <td>@t.Nombre</td>
                        <td>@t.oEstado?.Nombre</td>
                        <td class="text-center">
                            <button class="btn btn-warning btn-sm"
                                    onclick='abrirModal(@Html.Raw(json))'>
                                <i class="fas fa-edit"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- MODAL Crear / Editar -->
<div class="modal fade" id="modalTipoIncentivo" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Tipo Incentivo</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <form id="formTipoIncentivo" autocomplete="off">
                    <input type="hidden" id="txtid" value="0" />

                    <div class="mb-3">
                        <label class="form-label">Nombre</label>
                        <input id="txtnombre" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Estado</label>
                        <select id="cboestado" class="form-select"></select>
                    </div>

                    <div class="mt-3">
                        <div class="alert alert-danger d-none" id="mensajeError"></div>
                    </div>
                </form>
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button class="btn btn-primary" onclick="guardar()">Guardar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Éxito -->
<div class="modal fade" id="modalExito" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">Éxito</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="cuerpoExito"></div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Error -->
<div class="modal fade" id="modalMensaje" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Error</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="cuerpoMensaje"></div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            cargarEstados();
            $('#btnNuevo').click(() => abrirModal());
        });

        function abrirModal(data = null) {
            $('#mensajeError').addClass('d-none').html('');
            $('#formTipoIncentivo')[0].reset();
            $('#txtid').val(data ? data.IdTipoIncentivo : 0);

            if (data) {
                $('#txtnombre').val(data.Nombre);
                $('#cboestado').val(data.IdEstado);
            }

            new bootstrap.Modal('#modalTipoIncentivo').show();
        }

        function cargarEstados() {
            $.get('/TipoIncentivo/Estado', data => {
                $('#cboestado').empty();

                if (data.success) {
                    data.estados.forEach(e => {
                        $('#cboestado').append(
                            `<option value="${e.idEstado}">${e.nombre}</option>`
                        );
                    });
                } else {
                    $('#cuerpoMensaje').html(data.mensajes.join('<br/>'));
                    new bootstrap.Modal('#modalMensaje').show();
                }
            });
        }

        function guardar() {
            let obj = {
                IdTipoIncentivo: $('#txtid').val(),
                Nombre: $('#txtnombre').val(),
                oEstado: { IdEstado: $('#cboestado').val() }
            };

            let url = obj.IdTipoIncentivo == 0
                ? '/TipoIncentivo/Crear'
                : '/TipoIncentivo/Editar';

            $.post(url, obj, res => {
                $('#mensajeError').addClass('d-none').html('');

                if (res.success) {
                    bootstrap.Modal.getInstance(
                        document.getElementById('modalTipoIncentivo')
                    ).hide();

                    $('#cuerpoExito').html(res.mensajes.join('<br/>'));
                    new bootstrap.Modal('#modalExito').show();

                    setTimeout(() => location.reload(), 1500);
                } else {
                    let errores = res.mensajes?.map(m => `<p>${m}</p>`).join('');
                    $('#mensajeError').removeClass('d-none').html(errores);
                }
            });
        }
    </script>
}
