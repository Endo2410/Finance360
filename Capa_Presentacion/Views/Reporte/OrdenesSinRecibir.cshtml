@model List<Capa_Entidad.OrdenSinRecibir>

@{
    ViewData["Title"] = "Órdenes sin Recibir";
    Layout = "~/Views/Shared/_Layout.cshtml";

    DateTime fechaHoy = DateTime.Today;
    DateTime fechaLimite = fechaHoy.AddMonths(-3);
}

<ol class="breadcrumb mb-4 mt-4">
    <li class="breadcrumb-item">
        <a asp-controller="Home" asp-action="Bienvenido">Inicio</a>
    </li>
    <li class="breadcrumb-item active">Órdenes sin Recibir</li>
</ol>

<div class="card shadow border-0">

    <!-- HEADER -->
    <div class="card-header text-white d-flex justify-content-between align-items-center"
         style="background-color: #274DF5;">

        <div>
            <i class="fas fa-truck-loading me-2"></i> Órdenes sin Recibir
        </div>

        <div class="d-flex">

            <input type="date" id="fechaInicio"
                   class="form-control form-control-sm me-2"
                   value="@ViewBag.FechaInicio"
                   min="@fechaLimite.ToString("yyyy-MM-dd")"
                   max="@fechaHoy.ToString("yyyy-MM-dd")" />

            <input type="date" id="fechaFin"
                   class="form-control form-control-sm me-2"
                   value="@ViewBag.FechaFin"
                   min="@fechaLimite.ToString("yyyy-MM-dd")"
                   max="@fechaHoy.ToString("yyyy-MM-dd")" />

            <button class="btn btn-light btn-sm"
                    onclick="filtrar()">
                <i class="fas fa-search"></i>
            </button>

        </div>
    </div>

    <div id="mensajeFecha" class="text-danger px-3 mt-1" style="display:none;"></div>

    <div class="card-body">

        <!-- 🔥 FILTRO POR COLUMNA -->
        <div class="row mb-3">
            <div class="col-md-3">
                <select id="filtroCampo" class="form-control">
                    <option value="">-- Filtrar por --</option>
                    <option value="0">PO Number</option>
                    <option value="1">Farmacia</option>
                </select>
            </div>

            <div class="col-md-4">
                <input id="filtroValor"
                       class="form-control"
                       placeholder="Buscar..."
                       autocomplete="off"
                       onkeyup="filtrarColumna()" />
            </div>
        </div>

        <button id="btnExcelOrdenes" class="btn btn-success mb-3">
            <i class="fas fa-file-excel me-2"></i> Exportar a Excel
        </button>

        <button id="btnPdfOrdenes" class="btn btn-danger mb-3">
            <i class="fas fa-file-pdf me-2"></i> PDF
        </button>

        <!-- TABLA -->
        <table class="table table-striped" id="tablaOrdenes">
            <thead class="text-white" style="background-color: #274DF5;">
                <tr>
                    <th>PO Number</th>
                    <th>Farmacia</th>
                    <th>Fecha</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.PONumber</td>
                        <td>@item.Farmacia</td>
                        <td>@item.DateCreated.ToString("dd/MM/yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>

    </div>
</div>

@section scripts {
    <script>
        let tablaOrdenes;

        $(document).ready(function () {

            tablaOrdenes = $('#tablaOrdenes').DataTable({
                pageLength: 15,
                lengthChange: false,
                searching: true, // necesario para columnas
                ordering: false,
                responsive: true,
                language: {
                    paginate: { previous: "Anterior", next: "Siguiente" },
                    info: "Mostrando _START_ a _END_ de _TOTAL_ registros",
                    emptyTable: "No hay datos"
                }
            });

            // 🔥 OCULTAR BUSCADOR GLOBAL
            $('#tablaOrdenes_filter').hide();
        });

        function filtrarColumna() {
            let col = $("#filtroCampo").val();
            let val = $("#filtroValor").val();

            tablaOrdenes.columns().search('');

            if (col !== "") {
                tablaOrdenes.column(col).search(val).draw();
            } else {
                tablaOrdenes.search(val).draw();
            }
        }

        $("#btnExcelOrdenes").click(function () {

            let fechaInicio = $("#fechaInicio").val();
            let fechaFin = $("#fechaFin").val();

            let filtroCampo = $("#filtroCampo").val();
            let filtroValor = $("#filtroValor").val();

            let url = `/Reporte/ExportarExcelOrdenes?fechaInicio=${fechaInicio}&fechaFin=${fechaFin}&campo=${filtroCampo}&valor=${filtroValor}`;

            window.location.href = url;
        });

        $("#btnPdfOrdenes").click(function () {

            let fechaInicio = $("#fechaInicio").val();
            let fechaFin = $("#fechaFin").val();

            let filtroCampo = $("#filtroCampo").val();
            let filtroValor = $("#filtroValor").val();

            let url = `/Reporte/DescargarPdfOrdenes?fechaInicio=${fechaInicio}&fechaFin=${fechaFin}&campo=${filtroCampo}&valor=${filtroValor}`;

            window.open(url, "_blank");
        });

        function filtrar() {
            let inicio = $('#fechaInicio').val();
            let fin = $('#fechaFin').val();

            const hoy = new Date();
            const limite = new Date();
            limite.setMonth(limite.getMonth() - 3);

            const msg = $('#mensajeFecha');
            msg.hide();

            if (!inicio || !fin) {
                msg.text("Seleccione fechas válidas").show();
                return;
            }

            if (new Date(inicio) > new Date(fin)) {
                msg.text("Fecha inicio no puede ser mayor").show();
                return;
            }

            if (new Date(inicio) < limite || new Date(fin) > hoy) {
                msg.text("Solo últimos 3 meses").show();
                return;
            }

            window.location.href = `?fechaInicio=${inicio}&fechaFin=${fin}`;
        }
    </script>
}