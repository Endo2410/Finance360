@model List<Capa_Entidad.Departamento>

@{
    ViewData["Title"] = "Departamentos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<ol class="breadcrumb mb-4 mt-4">
    <li class="breadcrumb-item">
        <a asp-controller="Home" asp-action="Index">Inicio</a>
    </li>
    <li class="breadcrumb-item active">Departamentos</li>
</ol>


<div class="card shadow border-0">
    <div class="card-header text-white d-flex justify-content-between align-items-center"
         style="background-color:#274DF5;">
        <div>
            <i class="fas fa-map me-2"></i> Lista de Departamentos
        </div>

        <button class="btn btn-light btn-sm"
                onclick="abrirConfirmacion()">
            <i class="fas fa-sync-alt"></i> Importar Departamentos
        </button>
    </div>

    <!-- FILTROS -->
    <div class="row mt-3 mb-3 px-3">
        <div class="col-md-3">
            <select id="filtroCampoDepartamentos" class="form-control">
                <option value="">-- Seleccionar campo --</option>
                <option value="1">HQID</option>
                <option value="2">Departamento</option>
            </select>
        </div>

        <div class="col-md-4">
            <input id="filtroValorDepartamentos"
                   class="form-control"
                   placeholder="Buscar..." />
        </div>
    </div>

    <div class="card-body">
        <table class="table table-striped align-middle" id="tablaDepartamentos">
            <thead class="text-white" style="background-color:#274DF5;">
                <tr>
                    <th>ID</th>
                    <th>HQID</th>
                    <th>DEPARTAMENTO</th>
                    <th>FECHA ACTUALIZACIÓN</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model)
                {
                    <tr>
                        <td>@d.IdDepartamento</td>
                        <td>@d.IdOrigen</td>
                        <td>@d.NombreDepartamento</td>
                        <td>@d.FechaActualizacion.ToString("dd/MM/yyyy HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- MODAL CONFIRMACION -->
<div class="modal fade" id="modalConfirmSync" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark py-2">
                <h6 class="modal-title w-100 text-center">
                    Confirmación
                </h6>
            </div>
            <div class="modal-body text-center">
                <p class="mb-3">¿Desea sincronizar los departamentos?</p>
                <button class="btn btn-secondary btn-sm me-2"
                        data-bs-dismiss="modal">
                    Cancelar
                </button>
                <button class="btn btn-primary btn-sm"
                        onclick="confirmarSincronizacion()">
                    Sí, sincronizar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL RESULTADO -->
<div class="modal fade" id="modalSync" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header bg-success text-white py-2">
                <h6 class="modal-title w-100 text-center">
                    Sincronización
                </h6>
            </div>
            <div class="modal-body text-center">
                <p id="mensajeSync" class="mb-0"></p>
            </div>
        </div>
    </div>
</div>

@section scripts {
<script>
    let tablaDepartamentos;

    $(document).ready(function () {

        tablaDepartamentos = $('#tablaDepartamentos').DataTable({
            pageLength: 15,
            lengthChange: false,
            searching: true,
            ordering: false,
            responsive: true,
            dom: 'lrtip',
            language: {
                paginate: { previous: "Anterior", next: "Siguiente" },
                info: "Mostrando _START_ a _END_ de _TOTAL_ registros",
                infoEmpty: "Mostrando 0 a 0 de 0 registros",
                emptyTable: "No hay datos para mostrar"
            }
        });


        $("#filtroCampoDepartamentos, #filtroValorDepartamentos")
            .on("keyup change", function () {

                let col = $("#filtroCampoDepartamentos").val();
                let val = $("#filtroValorDepartamentos").val();

                tablaDepartamentos.columns().search('');

                if (col !== "") {
                    tablaDepartamentos.column(col).search(val).draw();
                } else {
                    tablaDepartamentos.search(val).draw();
                }
            });
    });

    function abrirConfirmacion() {
        new bootstrap.Modal(
            document.getElementById('modalConfirmSync')
        ).show();
    }

    function confirmarSincronizacion() {

        bootstrap.Modal
            .getInstance(document.getElementById('modalConfirmSync'))
            .hide();

        $.ajax({
            url: '@Url.Action("SincronizarDepartamento", "Proveedores")',
            type: 'POST',
            success: function (data) {

                $("#mensajeSync").html(
                    `<strong>Actualizados:</strong> ${data.actualizados}<br>
                     <strong>Insertados:</strong> ${data.insertados}`
                );

                let modal = new bootstrap.Modal(
                    document.getElementById('modalSync')
                );
                modal.show();

                setTimeout(() => {
                    modal.hide();
                    location.reload();
                }, 2000);
            },
            error: function () {
                $("#mensajeSync").text("Error al sincronizar departamentos");
                new bootstrap.Modal(
                    document.getElementById('modalSync')
                ).show();
            }
        });
    }
</script>
}
