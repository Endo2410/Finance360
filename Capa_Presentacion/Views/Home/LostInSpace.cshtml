@{
    Layout = null;
    ViewBag.Title = "Se perdió en el espacio";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>404 - Ruta no válida</title>

    <style>
        body {
            margin: 0;
            height: 100vh;
            background: #141414;
            color: white;
            font-family: Arial, Helvetica, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            text-align: center;
        }

        .container {
            max-width: 600px;
        }

        h1 {
            font-size: 70px;
            margin-bottom: 10px;
            color: #e50914;
        }

        h2 {
            font-weight: 400;
            margin-bottom: 20px;
        }

        p {
            color: #aaa;
            margin-bottom: 30px;
        }

        a {
            text-decoration: none;
            background: #e50914;
            color: white;
            padding: 12px 25px;
            border-radius: 5px;
            font-size: 16px;
            transition: 0.3s;
        }

            a:hover {
                background: #b20710;
            }

        .code {
            font-size: 140px;
            font-weight: bold;
            opacity: 0.15;
            position: absolute;
            top: 20%;
            left: 50%;
            transform: translateX(-50%);
        }
    </style>
</head>

<body>

    <div class="code">404</div>

    <div class="container">
        <h1>¡Ups!</h1>
        <h2>Te perdiste en el espacio 🚀</h2>
        <p>La ruta que intentaste acceder no existe o no tienes permiso.</p>

        <a href="@Url.Action("Index","Acceso")">
            Volver al inicio
        </a>
    </div>

</body>
</html>