                    <strong>@a.Tipo:</strong> @a.Mensaje
                </li>
            }
        </ul>
    </div>
</div>
 *@

<div class="card shadow mb-5">
    <div class="card-header bg-dark text-white">
        <i class="fas fa-table me-2"></i> Resumen Financiero por Proveedor
    </div>
    <div class="card-body">
        <table id="tablaProveedores" class="table table-striped table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>Proveedor</th>
                    <th>Publicidad</th>
                    <th>Rebate</th>
                    <th>Canjes</th>
                    <th>Vencido</th>
                    <th>Total Ingreso</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.TopProveedores)
                {
                    <tr>
                        <td>@p.Proveedor</td>
                        <td>C$ @p.Publicidad.ToString("N2")</td>
                        <td>C$ @p.Rebate.ToString("N2")</td>
                        <td>C$ @p.Canjes.ToString("N2")</td>
                        <td>C$ @p.Vencido.ToString("N2")</td>
                        <td class="fw-bold">C$ @p.TotalIngreso.ToString("N2")</td>
                    </tr>
                }

            </tbody>
        </table>
    </div>
</div>


<!-- =========================
 RESUMEN OPERATIVO
========================= -->
<div class="row mb-4">
    <div class="col-md-6">
        <div class="card shadow h-100">
            <div class="card-header bg-primary text-white">
                <i class="fas fa-chart-pie me-2"></i> Resumen Operativo
            </div>
            <div class="card-body d-flex flex-column justify-content-center">
                <p>📢 Publicidad activa: <strong>@Model.Activos.PublicidadActiva</strong></p>
                <p>💰 Rebates activos: <strong>@Model.Activos.RebateActivo</strong></p>
                <p>🔁 Canjes pendientes: <strong>@Model.Activos.CanjeActivo</strong></p>
                <p>⚠ Vencidos pendientes: <strong>@Model.Activos.VencidoActivo</strong></p>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card shadow h-100">
            <div class="card-header bg-info text-white">
                <i class="fas fa-chart-pie me-2"></i> Distribución de Operaciones Activas
            </div>
            <div class="card-body d-flex align-items-center justify-content-center">
                <canvas id="pieActivosChart" style="max-height: 200px;"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- =========================
 TOP PROVEEDORES
========================= -->
<div class="card shadow mb-5">
    <div class="card-header bg-dark text-white">
        <i class="fas fa-building me-2"></i> Saldos Vencidos por Proveedor
    </div>
    <div class="card-body">
        <table id="tablaSaldoPendiente" class="table table-striped table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>Proveedor</th>
                    <th>Publicidad</th>
                    <th>Rebate</th>
                    <th>Canjes</th>
                    <th>Departamento de Vencido</th>
                    <th>Total Saldo</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.TopProveedoresSaldoPendiente)
                {
                    <tr>
                        <td>@p.Proveedor</td>
                        <td>C$ @p.Publicidad.ToString("N2")</td>
                        <td>C$ @p.Rebate.ToString("N2")</td>
                        <td>C$ @p.Canjes.ToString("N2")</td>
                        <td>  C$ @p.Vencido.ToString("N2") </td>
                        <td class="fw-bold text-danger">
                            C$ @p.SaldoPendiente.ToString("N2")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {

    <!-- =========================
         LIBRERÍAS
    ========================= -->
    <!-- DataTables -->
    <link rel="stylesheet"
          href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />

    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>

    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <!-- =========================
         SCRIPT DASHBOARD
    ========================= -->
    <script>

        // =========================
        // INIT GENERAL
        // =========================
        $(document).ready(function () {
            initTablasDashboard();
            initGraficosDashboard();
        });


        // =========================
        // INICIALIZAR TABLAS
        // =========================
        function initTablasDashboard() {

            // Tabla: Top Proveedores (Ingresos)
            if (!$.fn.DataTable.isDataTable('#tablaProveedores')) {
                $('#tablaProveedores').DataTable({
                    pageLength: 10,
                    lengthChange: false,
                    searching: false,
                    ordering: false,
                    responsive: true,
                    language: {
                        paginate: {
                            previous: "Anterior",
                            next: "Siguiente"
                        },
                        info: "Mostrando _START_ a _END_ de _TOTAL_ registros",
                        emptyTable: "No hay datos disponibles"
                    }
                });
            }

            // Tabla: Saldo Pendiente
            if (!$.fn.DataTable.isDataTable('#tablaSaldoPendiente')) {
                $('#tablaSaldoPendiente').DataTable({
                    pageLength: 10,
                    lengthChange: false,
                    searching: false,
                    ordering: false,
                    responsive: true,
                    language: {
                        paginate: {
                            previous: "Anterior",
                            next: "Siguiente"
                        },
                        info: "Mostrando _START_ a _END_ de _TOTAL_ proveedores",
                        emptyTable: "No hay saldos pendientes"
                    }
                });
            }
        }


        // =========================
        // INICIALIZAR GRÁFICOS
        // =========================
        function initGraficosDashboard() {

            // -------------------------
            // GRÁFICO DE BARRAS (INGRESOS)
            // -------------------------
            const barCtx = document.getElementById('barChart')?.getContext('2d');
            if (barCtx) {
                new Chart(barCtx, {
                    type: 'bar',
                    data: {
                        labels: ['Publicidad', 'Rebate', 'Canjes', 'Vencido'],
                        datasets: [{
                            label: 'Monto en C$',
                            data: [
                                @publicidad,
                                @rebate,
                                @canjes,
                                @vencido
                            ],
                            backgroundColor: [
                                '#0d6efd',
                                '#198754',
                                '#ffc107',
                                '#dc3545'
                            ]
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: {
                            legend: { display: false }
                        },
                        scales: {
                            y: {
                                beginAtZero: true
                            }
                        }
                    }
                });
            }

            // -------------------------
            // GRÁFICO PASTEL (SALDO PENDIENTE)
            // -------------------------
            const pieCtx = document.getElementById('pieChart')?.getContext('2d');
            if (pieCtx) {
                new Chart(pieCtx, {
                    type: 'pie',
                    data: {
                        labels: ['Publicidad', 'Rebate', 'Canjes', 'Vencido'],
                        datasets: [{
                            data: [
                                @pendPublicidad,
                                @pendRebate,
                                @pendCanjes,
                                @pendVencido
                            ],
                            backgroundColor: [
                                '#0d6efd',
                                '#198754',
                                '#ffc107',
                                '#dc3545'
                            ]
                        }]
                    },
                    options: {
                        plugins: {
                            legend: {
                                position: 'bottom'
                            }
                        }
                    }
                });
            }

            // -------------------------
            // GRÁFICO PASTEL (ACTIVOS)
            // -------------------------
            const pieActivosCtx = document.getElementById('pieActivosChart')?.getContext('2d');
            if (pieActivosCtx) {
                new Chart(pieActivosCtx, {
                    type: 'pie',
                    data: {
                        labels: ['Publicidad', 'Rebate', 'Canjes', 'Vencido'],
                        datasets: [{
                            data: [
                                @Model.Activos.PublicidadActiva,
                                @Model.Activos.RebateActivo,
                                @Model.Activos.CanjeActivo,
                                @Model.Activos.VencidoActivo
                            ],
                            backgroundColor: [
                                '#0d6efd',
                                '#198754',
                                '#ffc107',
                                '#dc3545'
                            ]
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: {
                            legend: {
                                display: true,
                                position: 'left',
                                align: 'start',
                                labels: {
                                    boxWidth: 40,
                                    padding: 10
                                }
                            }
                        }
                    }
                });
            }
        }

        function abrirModalProveedorFiltro() {

            $.get('/Proveedores/Listar', function (data) {

                let tbody = $('#tablaProveedoresFiltro tbody');
                tbody.empty();

                data.forEach(p => {
                    tbody.append(`
                        <tr data-id="${p.idProveedor}" data-nombre="${p.nombre}">
                            <td>${p.ruc}</td>
                            <td>${p.nombre}</td>
                        </tr>
                    `);
                });

                $('#tablaProveedoresFiltro tbody tr').click(function () {
                    let id = $(this).data('id');
                    let nombre = $(this).data('nombre');

                    $('#idProveedorFiltro').val(id);
                    $('#txtProveedorFiltro').val(nombre);

                    bootstrap.Modal.getInstance(document.getElementById('modalProveedorFiltro')).hide();
                });
            });

            $('#txtFiltrarProveedorFiltro').val('');
            new bootstrap.Modal('#modalProveedorFiltro').show();
        }

        $('#txtFiltrarProveedorFiltro').on('keyup', function () {
            let valor = $(this).val().toLowerCase();

            $('#tablaProveedoresFiltro tbody tr').filter(function () {
                $(this).toggle($(this).text().toLowerCase().indexOf(valor) > -1);
            });
        });

    </script>
}
