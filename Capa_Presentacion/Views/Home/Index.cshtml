@model Capa_Entidad.DashboardViewModel



@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";


    var alertas = new[]
    {
        new { Tipo = "Publicidad", Mensaje = "Campaña Coca Cola vencida (15 días)", Nivel = "danger" },
        new { Tipo = "Canje", Mensaje = "Canje Nestlé con saldo pendiente", Nivel = "warning" },
        new { Tipo = "Factura", Mensaje = "Factura #4589 vence en 5 días", Nivel = "info" }
    };
}

@{
    decimal publicidad = Model.TotalPublicidad;
    decimal rebate = Model.TotalRebate;
    decimal canjes = Model.TotalCanjes;
    decimal vencido = Model.TotalVencido;
}

@{
    decimal pendPublicidad = Model.TopProveedoresSaldoPendiente.Sum(x => x.Publicidad);
    decimal pendRebate = Model.TopProveedoresSaldoPendiente.Sum(x => x.Rebate);
    decimal pendCanjes = Model.TopProveedoresSaldoPendiente.Sum(x => x.Canjes);
    decimal pendVencido = Model.TopProveedoresSaldoPendiente.Sum(x => x.Vencido);
}

@if (TempData["ErrorFecha"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-triangle me-2"></i>
        @TempData["ErrorFecha"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}



<!-- =========================
 BREADCRUMB
========================= -->
<ol class="breadcrumb mb-4 mt-4">
    <li class="breadcrumb-item active">Dashboard</li>
</ol>

<!-- =========================
 FILTRO DE FECHAS
========================= -->
<div class="card shadow mb-4">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-3 align-items-end">

            <div class="col-md-4">
                <label class="form-label">Fecha Inicio</label>
                <input type="date"
                       name="fechaInicio"
                       class="form-control"
                       value="@Context.Request.Query["fechaInicio"]" />
            </div>

            <div class="col-md-4">
                <label class="form-label">Fecha Fin</label>
                <input type="date"
                       name="fechaFin"
                       class="form-control"
                       value="@Context.Request.Query["fechaFin"]" />
            </div>

            <div class="col-md-4">
                <label class="form-label">Proveedor</label>
                <div class="input-group">
                    <input type="hidden" id="idProveedorFiltro" name="idProveedor" />
                    <input id="txtProveedorFiltro" class="form-control" placeholder="Seleccionar proveedor" readonly />
                    <button class="btn btn-secondary" type="button" onclick="abrirModalProveedorFiltro()">Buscar</button>
                </div>
            </div>


            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-filter me-1"></i> Filtrar
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-eraser me-1"></i> Limpiar
                </a>
            </div>

        </form>
    </div>
</div>


<!-- =========================
 KPI CARDS
========================= -->
<div class="row mb-4">

    <div class="col-md-3">
        <div class="card shadow border-left-warning">
            <div class="card-body">
                <h6 class="text-danger">Monto Vencido</h6>
                <h4>C$ @Model.MontoVencidoTotal.ToString("N2")</h4>
            </div>
        </div>
    </div>


    <div class="col-md-3">
        <div class="card shadow border-left-danger">
            <div class="card-body">
                <h6 class="text-warning">Saldo Pendiente</h6>
                <h4>C$ @Model.Resumen.SaldoPendiente.ToString("N2")</h4>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow border-left-success">
            <div class="card-body">
                <h6 class="text-success">Cobrado</h6>
                <h4>C$ @Model.Resumen.Cobrado.ToString("N2")</h4>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow border-left-primary">
            <div class="card-body">
                <h6 class="text-primary">% Recuperación</h6>
                <h4>@Model.Resumen.PorcentajeRecuperacion.ToString("N2") %</h4>
            </div>
        </div>
    </div>
</div>


<!-- =========================
 GRÁFICOS
========================= -->
<div class="row mb-5 align-items-stretch">

    <!-- BARRAS -->
    <div class="col-md-8">
        <div class="card shadow">
            <div class="card-header bg-primary text-white">
                <i class="fas fa-chart-bar me-2"></i> Ganancia por Tipo
            </div>
            <div class="card-body">
                <canvas id="barChart" height="142"></canvas>
            </div>
        </div>
    </div>

    <!-- PASTEL -->
    <div class="col-md-4">
        <div class="card shadow">
            <div class="card-header bg-dark text-white">
                <i class="fas fa-chart-pie me-2"></i> Distribución de Saldos Vencidos

            </div>
            <div class="card-body">
                <canvas id="pieChart"></canvas>
            </div>
        </div>
    </div>

</div>


<!-- =========================
 Modal Proveedores
========================= -->
<div class="modal fade" id="modalProveedorFiltro" tabindex="-1">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Seleccionar Proveedor</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="text" id="txtFiltrarProveedorFiltro"
                       class="form-control mb-3"
                       placeholder="Filtrar proveedor">

                <table class="table table-hover" id="tablaProveedoresFiltro">
                    <thead>
                        <tr>
                            <th>RUC</th>
                            <th>Nombre</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>


@* <!-- =========================
 ALERTAS
========================= -->
<div class="card shadow mb-4">
    <div class="card-header bg-danger text-white">
        <i class="fas fa-exclamation-triangle me-2"></i> Alertas Críticas
    </div>
    <div class="card-body">
        <ul class="list-group">
            @foreach (var a in alertas)
            {
