@model List<Capa_Entidad.Vencido>

@{
    ViewData["Title"] = "Pago de Vencidos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<ol class="breadcrumb mb-4 mt-4">
    <li class="breadcrumb-item">
        <a asp-controller="Home" asp-action="Index">Inicio</a>
    </li>
    <li class="breadcrumb-item active">Pago de Vencidos</li>
</ol>

<div class="card shadow border-0">
    <div class="card-header text-white" style="background-color:#274DF5;">
        <i class="fas fa-exclamation-circle me-2"></i> Registrar Pago de Vencidos
    </div>

    <div class="card-body">

        <!-- PROVEEDOR -->
        <div class="row mb-3">
            <div class="col-md-4">
                <label>Proveedor</label>
                <div class="input-group">
                    <input type="text" id="txtProveedorSeleccionado"
                           class="form-control"
                           placeholder="-- Seleccione --"
                           readonly>
                    <button class="btn btn-primary" type="button" id="btnAbrirModalProveedor">
                        <i class="fas fa-search"></i>
                    </button>
                </div>
                <input type="hidden" id="cmbProveedor">
            </div>
        </div>

        <!-- TABLA DE VENCIDOS -->
        <table class="table table-striped" id="tablaVencidos">
            <thead class="bg-primary text-white">
                <tr>
                    <th><input type="checkbox" id="chkTodos" /></th>
                    <th>Número Orden</th>
                    <th>Concepto</th>
                    <th>Fecha Creación</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>

        <button id="btnPagar" class="btn btn-success mt-2">
            <i class="fas fa-check"></i> Registrar Pago
        </button>
    </div>
</div>

<!-- MODAL PROVEEDORES -->
<div class="modal fade" id="modalProveedores" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Seleccionar Proveedor</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="text" id="txtBuscarProveedor"
                       class="form-control mb-2"
                       placeholder="Buscar proveedor...">
                <table class="table table-hover" id="tablaModalProveedores">
                    <thead>
                        <tr>
                            <th>Proveedor</th>
                            <th>Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach(var p in Model.Select(x => x.Proveedor).Distinct())
                        {
                            <tr>
                                <td>@p</td>
                                <td>
                                    <button class="btn btn-sm btn-success btnSeleccionarProveedor"
                                            data-nombre="@p">Seleccionar</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- MODAL DE PAGO -->
<div class="modal fade" id="modalPago" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">

            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Datos del Pago</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <h6 class="fw-bold text-primary">Vencido Seleccionado</h6>

                <div class="table-responsive mb-3">
                    <table class="table table-sm table-bordered" id="tablaVencidosSeleccionados">
                        <thead class="table-primary text-center">
                            <tr>
                                <th>Número Orden</th>
                                <th>Concepto</th>
                                <th>Fecha Creación</th>
                                <th class="text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>

                <div class="alert alert-success d-flex justify-content-between align-items-center">
                    <strong>Total a Pagar</strong>
                    <span id="lblTotal" class="fs-4 fw-bold" data-total="0">C$0.00</span>
                </div>

                <hr>

                <h6 class="fw-bold text-secondary">
                    <i class="fas fa-file-invoice-dollar me-1"></i> Forma de Pago
                </h6>

                <table class="table" id="tablaPagosTipos">
                    <thead>
                        <tr>
                            <th>Tipo Documento</th>
                            <th>Monto</th>
                             <th>N° Confirmación</th>
                            <th>Comprobante</th>
                            <th>Eliminar</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>

               <div class="row mb-3">
                    <div class="col-md-3">
                        <select id="cmbTipoDocAgregar" class="form-control">
                            <option value="">-- Seleccione Tipo --</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <input type="number" id="txtMontoAgregar" class="form-control" placeholder="Monto">
                    </div>
                    <div class="col-md-3">
                        <input type="text" id="txtNumeroConfirmacionAgregar" class="form-control" placeholder="N° Confirmación">
                    </div>
                    <div class="col-md-3">
                        <input type="file" id="fileComprobanteAgregar" class="form-control" accept=".jpg,.jpeg,.png,.pdf">
                    </div>
                    <div class="col-md-12 mt-2">
                        <button id="btnAgregarPago" class="btn btn-primary">Agregar Pago</button>
                    </div>
                </div>

                <label>Observación</label>
                <textarea id="txtObs" class="form-control"></textarea>

            </div>

            <div class="modal-footer">
                <button id="btnConfirmarPago" class="btn btn-success">Confirmar Pago</button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL MENSAJE -->
<div class="modal fade" id="modalMensaje" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Mensaje</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="modalBody"></div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL ÉXITO -->
<div class="modal fade" id="modalExito" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">Pago Registrado</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>El pago se registró correctamente.</p>
                <p><strong>Número de Documento:</strong> <span id="lblNumeroDoc"></span></p>
            </div>
        </div>
    </div>
</div>

@section scripts {
<script>
    const todosVencidos = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        Model.Select(x => new {
            x.IdVencido,
            x.NumeroOrden,
            x.Concepto,
            x.Proveedor,
            FechaCreacion = x.FechaCreacion.ToString("yyyy-MM-dd"),
            x.Total
        })
    ));

    let pagosTipos = [];

    function fMonto(m) { return m.toLocaleString('es-NI', { style: 'currency', currency: 'NIO' }); }
    function mostrarModal(msg) { $('#modalBody').text(msg); new bootstrap.Modal(document.getElementById('modalMensaje')).show(); }

    // Abrir modal proveedores
    $('#btnAbrirModalProveedor').click(() => new bootstrap.Modal(document.getElementById('modalProveedores')).show());

    // Seleccionar proveedor
    $(document).on('click', '.btnSeleccionarProveedor', function() {
        let prov = $(this).data('nombre');
        $('#txtProveedorSeleccionado').val(prov);
        $('#cmbProveedor').val(prov).trigger('change');
        bootstrap.Modal.getInstance(document.getElementById('modalProveedores')).hide();
    });

    // Buscar proveedor
    $('#txtBuscarProveedor').on('keyup', function() {
        let texto = $(this).val().toLowerCase();
        $('#tablaModalProveedores tbody tr').each(function() {
            let nombre = $(this).find('td:first').text().toLowerCase();
            $(this).toggle(nombre.includes(texto));
        });
    });

    // Cargar vencidos según proveedor
    $('#cmbProveedor').change(function() {
        let prov = $(this).val();
        let tbody = $('#tablaVencidos tbody');
        tbody.empty();
        $('#chkTodos').prop('checked', false);
        if (!prov) return;

        todosVencidos.filter(x => x.Proveedor === prov)
            .forEach(v => {
                tbody.append(`
                    <tr>
                        <td><input type="checkbox" class="chkVencido" value="${v.IdVencido}" data-total="${v.Total}" /></td>
                        <td>${v.NumeroOrden}</td>
                        <td>${v.Concepto}</td>
                        <td>${v.FechaCreacion}</td>
                        <td>${fMonto(v.Total)}</td>
                    </tr>
                `);
            });
    });

    $('#chkTodos').on('change', function(){ $('.chkVencido').prop('checked', this.checked); });

    // Bloquear selección múltiple
    $(document).on('change', '.chkVencido', function() {
        if ($(this).is(':checked')) $('.chkVencido').not(this).prop('checked', false);
    });

    // Botón Pagar
    $('#btnPagar').click(function() {
        let sel = $('.chkVencido:checked');
        if (sel.length === 0) return mostrarModal('Seleccione un vencido');

        let tbody = $('#tablaVencidosSeleccionados tbody').empty();
        let total = 0;

        sel.each(function() {
            let fila = $(this).closest('tr');
            let monto = parseFloat($(this).data('total'));
            total += monto;
            tbody.append(`
                <tr>
                    <td>${fila.find('td:eq(1)').text()}</td>
                    <td>${fila.find('td:eq(2)').text()}</td>
                    <td>${fila.find('td:eq(3)').text()}</td>
                    <td class="text-end">${fMonto(monto)}</td>
                </tr>
            `);
        });

        $('#lblTotal').text(fMonto(total)).data('total', total);

        // Cargar tipos de documento
        $.get('/TipoDocumentoPago/ListarTipos', function(res) {
            $('#cmbTipoDocAgregar').empty().append('<option value="">-- Seleccione Tipo --</option>');
            res.forEach(t => $('#cmbTipoDocAgregar').append(`<option value="${t.id}">${t.nombre}</option>`));
        });

        new bootstrap.Modal(document.getElementById('modalPago')).show();
    });

    // Agregar pago
      $('#btnAgregarPago').click(function() {
            let tipoId = $('#cmbTipoDocAgregar').val();
            let tipoNombre = $('#cmbTipoDocAgregar option:selected').text();
            let monto = parseFloat($('#txtMontoAgregar').val());
            let numeroConfirmacion = $('#txtNumeroConfirmacionAgregar').val(); 
            let file = $('#fileComprobanteAgregar')[0].files[0];

            if (!tipoId || !monto || monto <= 0) return mostrarModal('Seleccione tipo y monto válido');
            if (!numeroConfirmacion) return mostrarModal('Ingrese N° de Confirmación');
            if (!file) return mostrarModal('Debe seleccionar un comprobante');

            pagosTipos.push({ id: parseInt(tipoId), nombre: tipoNombre, monto: monto, numeroConfirmacion, file });

            let tbody = $('#tablaPagosTipos tbody');
            tbody.append(`
                <tr>
                    <td>${tipoNombre}</td>
                    <td class="text-end">${fMonto(monto)}</td>
                    <td>${numeroConfirmacion}</td>
                    <td>${file.name}</td>
                    <td><button class="btn btn-sm btn-danger btnEliminarPago">X</button></td>
                </tr>
            `);

            $('#cmbTipoDocAgregar').val('');
            $('#txtMontoAgregar').val('');
            $('#txtNumeroConfirmacionAgregar').val('');
            $('#fileComprobanteAgregar').val('');
        });

    // Eliminar pago
    $(document).on('click', '.btnEliminarPago', function() {
        let index = $(this).closest('tr').index();
        pagosTipos.splice(index, 1);
        $(this).closest('tr').remove();
    });

     // Confirmar pago
     $('#btnConfirmarPago').click(function() {
        let vencidoSeleccionado = $('.chkVencido:checked');
        if (vencidoSeleccionado.length !== 1) return mostrarModal('Debe seleccionar un solo vencido');

        let idVencido = parseInt(vencidoSeleccionado.val());
        if (isNaN(idVencido)) return mostrarModal('Id del vencido inválido');

        if (pagosTipos.length === 0) return mostrarModal('Agregue al menos un pago');

        let totalAPagar = parseFloat($('#lblTotal').data('total'));
        let totalPagos = pagosTipos.reduce((s, x) => s + parseFloat(x.monto), 0);
        if (totalPagos + 0.01 < totalAPagar) return mostrarModal('La suma de los pagos no puede ser menor al total a pagar');


        let usuarioActual = '@ViewBag.UsuarioActual'; 

        let detalleEnvio = pagosTipos.map(p => ({
            IdVencido: idVencido,
            MontoPagado: parseFloat(p.monto),
            IdTipoDocumento: p.id,
            NumeroConfirmacion: p.numeroConfirmacion,
            RutaComprobante: p.file ? p.file.name : null,
            UsuarioPago: usuarioActual
        }));

        let formData = new FormData();
        formData.append('IdVencido', idVencido);
        formData.append('Observacion', $('#txtObs').val());
        formData.append('DetallePagos', JSON.stringify(detalleEnvio));
        formData.append('TotalAPagar', totalAPagar);

        pagosTipos.forEach((p, i) => { if (p.file) formData.append(`PagosTipos[${i}].Comprobante`, p.file); });

        $.ajax({
            url: '/PagoVencido/RegistrarPagoMultiples',
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            success: function(r) {
                if (r.success) {
                    $('#lblNumeroDoc').text(r.numeroDocumento);
                    new bootstrap.Modal(document.getElementById('modalExito')).show();
                    setTimeout(() => location.reload(), 3000);
                } else mostrarModal(r.mensajes.join("\n"));
            },
            error: function() { mostrarModal('Error al registrar el pago'); }
        });
    });
</script>
}
