    <table id="tablaMovimientos" class="table table-bordered table-striped">

        <thead class="table-dark">
            <tr>
                <th>Fecha</th>
                <th>Tipo Uso</th>
                <th>Monto</th>
                <th>Comprobante</th>
                <th>Usuario</th>
                <th>Observación</th>
                <th>Detalle</th>
            </tr>
        </thead>

        <tbody id="tbodyMovimientos"></tbody>

    </table>

