        $('#btnExportarPDF').click(function () {

            let nuevaVentana = window.open('', '_blank'); // 🔥 abrir primero

            let data = [];

            let nombre = $('#filtroNombre').val().toLowerCase();
            let sucursal = $('#filtroSucursal').val().toLowerCase();
            let departamento = $('#filtroDepartamento').val().toLowerCase();
            let fechaInicio = $('#filtroFechaInicio').val();
            let fechaFin = $('#filtroFechaFin').val();

            document.querySelectorAll(".card-item").forEach(card => {

                let cNombre = card.dataset.nombre;
                let cSucursal = card.dataset.sucursal;
                let cDepartamento = card.dataset.departamento;
                let cFechas = card.dataset.fechas.split(',');

                let cumpleFecha = true;

                if (fechaInicio || fechaFin) {
                    cumpleFecha = cFechas.some(f => {
                        if (!f) return false;
                        if (fechaInicio && f < fechaInicio) return false;
                        if (fechaFin && f > fechaFin) return false;
                        return true;
                    });
                }

                let cumple =
                    (!nombre || cNombre.includes(nombre)) &&
                    (!sucursal || cSucursal.includes(sucursal)) &&
                    (!departamento || cDepartamento.includes(departamento)) &&
                    cumpleFecha;

                if (!cumple) return;

                data.push({
                    Nombre: card.querySelector("h5").innerText,
                    Sucursal: card.dataset.sucursal,
                    Departamento: card.dataset.departamento,
                    Fechas: card.dataset.fechas
                });

            });

            if (data.length === 0) {
                nuevaVentana.close(); // cerrar si no hay datos
                alert("No hay datos para exportar");
                return;
            }

            $.ajax({
                url: '/Incentivo/ExportarCitasPDF',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(data),
                xhrFields: { responseType: 'blob' },
                success: function (blob) {

                    let url = window.URL.createObjectURL(blob);

                    // 🔥 cargar el PDF en la pestaña ya abierta
                    nuevaVentana.location.href = url;
                }
            });

        });

    </script>
