@{
    ViewData["Title"] = "Depósitos de Cierres";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="container-fluid mt-3">

    <div class="row">

        <!-- 🔹 FILTRO IZQUIERDA -->
        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-header text-white" style="background-color:#274DF5;">
                    Filtros
                </div>

                <div class="card-body">

                    <!-- FILTRO -->
                    <div class="row align-items-end">

                        <div class="col-12">
                            <label>Sucursal</label>

                            <div class="input-group">

                                <input type="hidden" id="cbosucursal" />

                                <input id="txtSucursalNombre"
                                       class="form-control"
                                       readonly>

                                <button class="btn btn-secondary"
                                        id="btnBuscarSucursal"
                                        type="button"
                                        onclick="abrirModalSucursal()">
                                    Buscar
                                </button>

                            </div>
                        </div>

                    </div>

                    <label>Fechas</label>
                    <ul class="list-group">
                        <li class="list-group-item active">06/04/2026</li>
                        <li class="list-group-item">07/04/2026</li>
                        <li class="list-group-item">08/04/2026</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- 🔹 CIERRES -->
        <div class="col-md-9">
            <div class="card shadow-sm">

                <div class="card-header text-white" style="background-color:#274DF5;">
                    Cierres Seleccionados
                </div>

                <div class="card-body p-0">

                    <div class="table-responsive">
                        <table class="table table-sm table-bordered mb-0">
                            <thead style="background-color: #e7edff; color: #374151;">
                                <tr>
                                    <th></th>
                                    <th>Fecha Cierre</th>
                                    <th>Caja</th>
                                    <th>Cierre</th>
                                    <th>Venta Detallada</th>
                                    <th>Ventas</th>
                                    <th>Iva</th>
                                    <th>Diferencia</th>
                                    <th>Apertura</th>
                                    <th>Total Venta</th>
                                    <th>Monto Cierre</th>
                                    <th>Excedente</th>
                                    <th>Usuario</th>
                                </tr>
                            </thead>
                            <tbody id="tbodyBatch"></tbody>
                        </table>
                    </div>

                </div>

                <div class="card-footer d-flex justify-content-between">
                    <strong>Total Ventas: C$ 0.00</strong>
                    <span class="text-danger fw-bold">
                        Over/Short: C$ 0.00
                    </span>
                </div>

            </div>
        </div>

    </div>

    <!-- 🔻 SEGUNDA FILA -->
    <div class="row mt-3">

        <!-- 🔹 DEPÓSITOS -->
        <div class="col-md-8">
            <div class="card shadow-sm">

                <div class="card-header text-white" style="background-color:#274DF5;">
                    Depósitos
                </div>

                <div class="card-body p-0">

                    <div class="table-responsive">
                        <table class="table table-sm table-bordered mb-0">
                            <thead style="background-color: #e7edff; color: #374151;">
                                <tr>
                                    <th>Fecha Deposito</th>
                                    <th>Tipo</th>
                                    <th>Número</th>
                                    <th>Monto</th>
                                    <th>Usuario</th>
                                    <th>Fecha Actualizado</th>
                                </tr>
                            </thead>
                            <tbody id="tbodyDepositos"></tbody>
                        </table>
                    </div>

                </div>

                <div class="card-footer d-flex justify-content-between">
                    <strong>Total: C$ 0.00</strong>
                    <span class="text-success fw-bold">
                        Diferencia: C$ 0.00
                    </span>
                </div>

            </div>
        </div>

        <!-- 🔹 IMAGEN VOUCHER -->
        <div class="col-md-4">
            <div class="card shadow-sm text-center">

                <div class="card-header text-white" style="background-color:#274DF5;">
                    Comprobante
                </div>

                <div class="card-body">
                    <img id="imgVoucher"
                         src="https://via.placeholder.com/250x400"
                         class="img-fluid border rounded" />

                    <div class="mt-3">
                        <button class="btn btn-outline-primary btn-sm">+</button>
                        <button class="btn btn-outline-danger btn-sm">X</button>
                        <button class="btn btn-outline-secondary btn-sm">✎</button>
                    </div>
                </div>

            </div>
        </div>

    </div>

    <!-- BOTÓN -->
    <div class="mt-3 text-end">
        <button class="btn btn-success" id="btnNuevoDeposito">
            Registrar Depósito
        </button>
    </div>

</div>


<!-- 🔥 MODAL REGISTRAR DEPÓSITO -->
<div class="modal fade" id="modalDeposito" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Registrar Depósito</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <div class="mb-2">
                    <label>Monto</label>
                    <input type="number" id="txtMonto" class="form-control" />
                </div>

                <div class="mb-2">
                    <label>Banco / Tipo</label>
                    <select id="txtTipoPago" class="form-control">
                        <option value="">-- Seleccionar --</option>
                        <option>BAC</option>
                        <option>BAMPRO</option>
                    </select>
                </div>

                <div class="mb-2">
                    <label>Comprobante</label>
                    <input type="file" id="fileImagen" class="form-control" />
                </div>

            </div>

            <div class="modal-footer">
                <button class="btn btn-primary" id="btnGuardarDeposito">
                    Guardar
                </button>
            </div>

        </div>
    </div>
</div>

<!-- ================= MODAL SUCURSAL ================= -->
<div class="modal fade" id="modalsucursal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-md modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Seleccionar Sucursal</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <div class="mb-3">
                    <input type="text" id="txtFiltrarsucusal" class="form-control" placeholder="Filtrar sucursal por nombre o codigo ">
                </div>
                <div style="max-height: 400px; overflow-y: auto;">
                    <table class="table table-striped table-hover" id="tablasucursal">
                        <thead style="position: sticky; top: 0; background: white;">
                            <tr>
                                <th>Codigo</th>
                                <th>Nombre</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Se llena dinámicamente -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script>

        // ================= SUCURSAL =================
        function abrirModalSucursal() {
            cargarSucursalModal();
            $('#txtFiltrarsucusal').val('');
            new bootstrap.Modal('#modalsucursal').show();
        }

        function cargarSucursalModal() {
            $.get('/Cuentas_X_PagarAlejandra/Listar', function (data) {
                let tbody = $('#tablasucursal tbody');
                tbody.empty();
                data.forEach(p => {
                    tbody.append(`
                 <tr data-id="${p.idsucursal}" data-nombre="${p.nombre}">
                    <td>${p.codigo}</td>
                    <td>${p.nombre}</td>
                 </tr>                      
            `);
                });

                // Click en la fila selecciona proveedor automáticamente
                $('#tablasucursal tbody tr').click(function () {

                    let id = $(this).data('id');
                    let nombre = $(this).data('nombre');

                    $('#cbosucursal').val(id);
                    $('#txtSucursalNombre').val(nombre);

                    bootstrap.Modal.getInstance(
                        document.getElementById('modalsucursal')
                    ).hide();


                });
            });
        }

        function seleccionarSucursal(id, nombre) {
            $('#cbosucursal').val(id);
            $('#txtSucursalNombre').val(nombre);
            bootstrap.Modal.getInstance(document.getElementById('modalsucursal')).hide();
        }

        // Filtro dinámico
        $('#txtFiltrarsucusal').on('keyup', function () {
            let valor = $(this).val().toLowerCase();
            $('#tablasucursal tbody tr').filter(function () {
                $(this).toggle($(this).text().toLowerCase().indexOf(valor) > -1);
            });
        });

        // 🔹 DATA SIMULADA
        let cierres = [
            { fecha: "2026-04-01", caja: 1, lote: 1001, total: 5000 },
            { fecha: "2026-04-01", caja: 2, lote: 1002, total: 3000 },
            { fecha: "2026-04-01", caja: 1, lote: 1003, total: 7000 }
        ];

        let depositos = [
            { fecha: "2026-04-02", tipo: "BAC", monto: 5000, usuario: "Luis", img: "" },
            { fecha: "2026-04-02", tipo: "BAC", monto: 3000, usuario: "Luis", img: "" },
            { fecha: "2026-04-02", tipo: "BAMPRO", monto: 7000, usuario: "Luis", img: "" }
        ];

        let batchesSeleccionados = [];
        let imagenActual = "";

        $(document).ready(function () {

            renderCierres();
            renderDepositos();
            calcularTotales();

        });

        // 🔹 PINTAR CIERRES
        function renderCierres() {

            let tbody = $('#tbodyBatch');
            tbody.empty();

            cierres.forEach(c => {

                tbody.append(`
                            <tr>
                                <td>
                                    <input type="checkbox" class="checkBatch" value="${c.lote}">
                                </td>
                                <td>${c.fecha}</td>
                                <td>${c.caja}</td>
                                <td>${c.lote}</td>
                                <td>C$ ${c.total.toFixed(2)}</td>
                                <td>0.00</td>
                                <td>0.00</td>
                                <td>0.00</td>
                                <td>0.00</td>
                                <td>0.00</td>
                                <td>0.00</td>
                                <td>0.00</td>
                                <td>Admin</td>
                            </tr>
                        `);
            });

        }

        // 🔹 PINTAR DEPÓSITOS
        function renderDepositos() {

            let tbody = $('#tbodyDepositos');
            tbody.empty();

            depositos.forEach((d, i) => {

                tbody.append(`
                                <tr class="filaDeposito" data-index="${i}">
                                    <td>${d.fecha}</td>
                                    <td>${d.tipo}</td>
                                      <td>1254</td>
                                    <td><strong>C$ ${d.monto.toFixed(2)}</strong></td>
                                    <td>${d.usuario}</td>
                                       <td>${d.fecha}</td>
                                </tr>
                            `);

            });

        }

        // 🔹 CALCULAR TOTALES
        function calcularTotales() {

            let totalVentas = 0;
            let totalDepositos = 0;

            cierres.forEach(c => totalVentas += c.total);
            depositos.forEach(d => totalDepositos += d.monto);

            let diferencia = totalDepositos - totalVentas;

            // 🔹 ACTUALIZAR UI
            $('.card-footer strong').first().text(`Total Ventas: C$ ${totalVentas.toFixed(2)}`);
            $('.card-footer strong').last().text(`Total: C$ ${totalDepositos.toFixed(2)}`);

            let diffText = `Diferencia: C$ ${diferencia.toFixed(2)}`;
            let diffElement = $('.card-footer span').last();

            diffElement.text(diffText);

            if (diferencia === 0) {
                diffElement.removeClass().addClass("text-success fw-bold");
            } else if (diferencia < 0) {
                diffElement.removeClass().addClass("text-danger fw-bold");
            } else {
                diffElement.removeClass().addClass("text-primary fw-bold");
            }

        }

        // 🔹 CHECKBOX SELECCIÓN
        $(document).on('change', '.checkBatch', function () {

            batchesSeleccionados = [];

            $('.checkBatch:checked').each(function () {
                batchesSeleccionados.push($(this).val());
            });

        });

        // 🔹 ABRIR MODAL
        $('#btnNuevoDeposito').click(function () {

            if (batchesSeleccionados.length === 0) {
                alert("Selecciona al menos un cierre");
                return;
            }

            new bootstrap.Modal('#modalDeposito').show();

        });

        // 🔹 PREVIEW IMAGEN
        $('#fileImagen').change(function () {

            let file = this.files[0];

            if (!file) return;

            let reader = new FileReader();

            reader.onload = function (e) {
                imagenActual = e.target.result;
                $('#imgVoucher').attr('src', imagenActual);
            };

            reader.readAsDataURL(file);

        });

        // 🔹 GUARDAR DEPÓSITO
        $('#btnGuardarDeposito').click(function () {

            let monto = parseFloat($('#txtMonto').val());
            let tipo = $('#txtTipoPago').val();

            if (!monto || !tipo || !imagenActual) {
                alert("Completa todos los campos");
                return;
            }

            let hoy = new Date().toISOString().split('T')[0];

            depositos.push({
                fecha: hoy,
                tipo: tipo,
                monto: monto,
                usuario: "Admin",
                img: imagenActual
            });

            renderDepositos();
            calcularTotales();

            console.log("Batches:", batchesSeleccionados);

            alert("Depósito guardado ✅");

            bootstrap.Modal.getInstance(document.getElementById('modalDeposito')).hide();

            // limpiar
            $('#txtMonto').val('');
            $('#txtTipoPago').val('');
            $('#fileImagen').val('');
            imagenActual = "";

        });

        // 🔹 CLICK EN DEPÓSITO → VER IMAGEN
        $(document).on('click', '.filaDeposito', function () {

            let index = $(this).data('index');
            let dep = depositos[index];

            if (dep.img) {
                $('#imgVoucher').attr('src', dep.img);
            } else {
                $('#imgVoucher').attr('src', 'https://via.placeholder.com/250x400');
            }
        });
    </script>
}