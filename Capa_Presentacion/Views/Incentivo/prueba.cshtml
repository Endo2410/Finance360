
@{
    ViewData["Title"] = "prueba";
}

@* <h1>prueba</h1>
 *@
<div class="container-fluid">

    <!-- TITULO -->
    <div class="row mb-3">
        <div class="col">
            <h4 class="fw-bold">Saldo de Incentivos por Sucursal</h4>
        </div>
    </div>

    <!-- FILTRO -->
    <div class="card mb-3">
        <div class="card-body">

            <div class="row align-items-end">

                <div class="col-md-4">
                    <label>Sucursal</label>

                    <div class="input-group">

                        <input type="hidden" id="cbosucursal" />

                        <input id="txtSucursalNombre"
                               class="form-control"
                               readonly>

                        <button class="btn btn-secondary"
                                type="button"
                                onclick="abrirModalSucursal()">
                            Buscar
                        </button>

                    </div>
                </div>


                <div class="col-md-3">
                    <button class="btn btn-success w-100"
                            id="btnUsarSaldo"
                            data-bs-toggle="modal"
                            data-bs-target="#modalUsoIncentivo">
                        <i class="fas fa-minus-circle"></i> Usar saldo
                    </button>
                </div>

            </div>

        </div>
    </div>


    <!-- TARJETA SALDO -->
    <div class="row mb-3">
        <div class="col-md-4">

            <div class="card border-success">
                <div class="card-body text-center">

                    <h6 class="text-muted">SALDO DISPONIBLE</h6>

                    <h3 class="text-success fw-bold"
                        id="lblSaldoDisponible">
                        C$ 0.00
                    </h3>

                </div>
            </div>

        </div>
    </div>


    <!-- INCENTIVOS RECIBIDOS -->
    <div class="card mb-3">

        <div class="card-header bg-primary text-white">
            Incentivos Recibidos
        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-bordered table-striped">

                    <thead class="table-dark">
                        <tr>
                            <th>Fecha</th>
                            <th>Documento</th>
                            <th>Proveedor</th>
                            <th>Monto</th>
                        </tr>
                    </thead>

                    <tbody id="tbodyIncentivosRecibidos">
                        <!-- dinámico -->
                    </tbody>

                </table>

            </div>

        </div>

    </div>



    <!-- USOS DEL INCENTIVO -->
    <div class="card">

        <div class="card-header bg-primary text-white">
            Usos del Incentivo
        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-bordered table-striped">

                    <thead class="table-dark">
                        <tr>
                            <th>Fecha</th>
                            <th>Tipo Uso</th>
                            <th>Monto</th>
                            <th>Usuario</th>
                            <th>Observación</th>
                        </tr>
                    </thead>

                    <tbody id="tbodyMovimientos">
                        <!-- dinámico -->
                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>



<!-- MODAL USAR SALDO -->
<div class="modal fade" id="modalUsoIncentivo" tabindex="-1">

    <div class="modal-dialog">
        <div class="modal-content">

            <!-- HEADER -->
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">
                    Registrar Uso de Incentivo
                </h5>

                <button class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>


            <!-- BODY -->
            <div class="modal-body">

                <div class="mb-3">
                    <label class="form-label">
                        Sucursal
                    </label>

                    <input type="text"
                           id="txtSucursalUso"
                           class="form-control"
                           readonly>
                </div>


                <div class="mb-3">
                    <label class="form-label">
                        Tipo Uso
                    </label>

                    <select id="cboTipoUso"
                            class="form-select">
                        <option value="">
                            Seleccione
                        </option>
                    </select>
                </div>


                <div class="mb-3">
                    <label class="form-label">
                        Monto
                    </label>

                    <input type="number"
                           id="txtMontoUso"
                           class="form-control">
                </div>


                <div class="mb-3">
                    <label class="form-label">
                        Observación
                    </label>

                    <textarea id="txtObservacionUso"
                              class="form-control">
                    </textarea>
                </div>


                <div id="mensajeErrorUso"
                     class="alert alert-danger d-none">
                </div>

            </div>


            <!-- FOOTER -->
            <div class="modal-footer">

                <button class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancelar
                </button>

                <button class="btn btn-success"
                        id="btnGuardarUso">

                    Guardar
                </button>

            </div>

        </div>
    </div>

</div>



<!-- ================= MODAL SUCURSAL ================= -->
<div class="modal fade" id="modalsucursal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Seleccionar Sucursal</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <div class="mb-3">
                    <input type="text" id="txtFiltrarsucusal" class="form-control" placeholder="Filtrar sucursal por nombre o codigo ">
                </div>
                <table class="table table-striped table-hover" id="tablasucursal">
                    <thead>
                        <tr>
                            <th>Codigo</th>
                            <th>Nombre</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Se llena dinámicamente -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>




@section Scripts {

    <script>


        // ================= SUCURSAL =================

        function abrirModalSucursal() {
            cargarSucursalModal();
            $('#txtFiltrarsucusal').val('');
            new bootstrap.Modal('#modalsucursal').show();
        }


        function cargarSucursalModal() {
            $.get('/Cuentas_X_PagarAlejandra/Listar', function (data) {
                let tbody = $('#tablasucursal tbody');
                tbody.empty();
                data.forEach(p => {
                    tbody.append(`
                        <tr data-id="${p.idsucursal}" data-nombre="${p.nombre}">
                            <td>${p.codigo}</td>
                            <td>${p.nombre}</td>
                        </tr>
                    `);
                });

                // Click en la fila selecciona proveedor automáticamente
                $('#tablasucursal tbody tr').click(function () {
                    let id = $(this).data('id');
                    let nombre = $(this).data('nombre');
                    $('#cbosucursal').val(id);
                    $('#txtSucursalNombre').val(nombre);
                    bootstrap.Modal.getInstance(document.getElementById('modalsucursal')).hide();
                });
            });
        }

        function seleccionarSucursal(id, nombre) {
            $('#cbosucursal').val(id);
            $('#txtSucursalNombre').val(nombre);
            bootstrap.Modal.getInstance(document.getElementById('modalsucursal')).hide();
        }

        // Filtro dinámico
        $('#txtFiltrarsucusal').on('keyup', function () {
            let valor = $(this).val().toLowerCase();
            $('#tablasucursal tbody tr').filter(function () {
                $(this).toggle($(this).text().toLowerCase().indexOf(valor) > -1);
            });
        });
    </script>
}
