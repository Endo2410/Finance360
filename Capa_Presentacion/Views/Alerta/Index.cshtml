@using System.Text.Json
@model List<Capa_Entidad.AlertaUsuario>

@{
    ViewData["Title"] = "Asignación de Alertas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<ol class="breadcrumb mb-4 mt-4">
    <li class="breadcrumb-item">
        <a asp-controller="Home" asp-action="Index">Inicio</a>
    </li>
    <li class="breadcrumb-item active">Alertas por Usuario</li>
</ol>

<div class="card shadow border-0">
    <div class="card-header text-white d-flex justify-content-between align-items-center"
         style="background-color:#274DF5;">
        <span>Lista de Alertas Asignadas</span>
        <button id="btnNuevo" class="btn btn-light btn-sm">
            Nueva Asignación
        </button>
    </div>

    <div class="card-body">
        <table class="table table-striped align-middle">
            <thead class="text-white" style="background-color:#274DF5;">
                <tr>
                    <th>ID</th>
                    <th>Usuario</th>
                    <th>Tipo Alerta</th>
                    <th>Estado</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Count > 0)
                {
                    foreach (var a in Model)
                    {
                        var json = JsonSerializer.Serialize(new
                        {
                            a.IdAlertaUsuario,
                            a.IdUsuario,
                            a.IdTipoAlerta,
                            a.IdEstado
                        });

                        <tr>
                            <td>@a.IdAlertaUsuario</td>
                            <td>@a.oUsuario?.NombreUsuario</td>
                            <td>@a.oTipoAlerta?.Codigo</td>
                            <td>@a.oEstado?.Nombre</td>
                            <td class="text-center">
                                <button class="btn btn-warning btn-sm"
                                        onclick='abrirModal(@Html.Raw(json))'>
                                    Editar
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center">
                            No hay registros disponibles.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- ===================== MODAL ===================== -->

<div class="modal fade" id="modalAlerta" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Asignar Alerta</h5>
                <button type="button" class="btn-close btn-close-white"
                        data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <input type="hidden" id="txtid" value="0" />

                <div class="mb-3">
                    <label class="form-label">Usuario</label>
                    <select id="cbousuario" class="form-select"></select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Tipo de Alerta</label>
                    <select id="cbotipoalerta" class="form-select"></select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Estado</label>
                    <select id="cboestado" class="form-select"></select>
                </div>

                <div id="mensajeError"
                     class="alert alert-danger d-none">
                </div>

            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancelar
                </button>

                <button class="btn btn-primary"
                        onclick="guardar()">
                    Guardar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>

        $(document).ready(function () {

            cargarUsuarios();
            cargarTipoAlerta();
            cargarEstados();

            $('#btnNuevo').click(function () {
                abrirModal();
            });

        });

        function abrirModal(a = null) {

            $('#mensajeError').addClass('d-none').html('');
            $('#txtid').val(0);

            if (a != null) {
                $('#txtid').val(a.IdAlertaUsuario);
                $('#cbousuario').val(a.IdUsuario);
                $('#cbotipoalerta').val(a.IdTipoAlerta);
                $('#cboestado').val(a.IdEstado);
            }

            new bootstrap.Modal(document.getElementById('modalAlerta')).show();
        }

        function cargarUsuarios() {

            $.get('/Alerta/ListarUsuarios', function (data) {

                $('#cbousuario').empty();

                $.each(data, function (index, item) {
                    $('#cbousuario').append(
                        `<option value="${item.idUsuario}">
                            ${item.nombre}
                        </option>`
                    );
                });
            });
        }

        function cargarTipoAlerta() {

            $.get('/Alerta/ListarTipoAlerta', function (data) {

                $('#cbotipoalerta').empty();

                $.each(data, function (index, item) {
                    $('#cbotipoalerta').append(
                        `<option value="${item.idTipoAlerta}">
                            ${item.codigo}
                        </option>`
                    );
                });
            });
        }

        function cargarEstados() {

            $.get('/Alerta/Estado', function (data) {

                if (data.success) {

                    $('#cboestado').empty();

                    $.each(data.estados, function (index, item) {
                        $('#cboestado').append(
                            `<option value="${item.idEstado}">
                                ${item.nombre}
                            </option>`
                        );
                    });

                }
            });
        }

        function guardar() {

            let alerta = {
                IdAlertaUsuario: $('#txtid').val(),
                IdUsuario: $('#cbousuario').val(),
                IdTipoAlerta: $('#cbotipoalerta').val(),
                IdEstado: $('#cboestado').val()
            };

            let url = alerta.IdAlertaUsuario == 0
                ? '/Alerta/Crear'
                : '/Alerta/Editar';

            $.post(url, alerta, function (response) {

                if (response.success) {
                    location.reload();
                }
                else {
                    $('#mensajeError')
                        .removeClass('d-none')
                        .html(response.mensajes.join('<br/>'));
                }

            });
        }

    </script>
}
