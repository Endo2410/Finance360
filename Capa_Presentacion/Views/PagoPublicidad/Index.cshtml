@model List<Capa_Entidad.EstadoCuentaPublicidad>

@{
    ViewData["Title"] = "Pago de Cuotas Publicidad";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- =========================================
 BREADCRUMB / NAVEGACIÓN
========================================= -->
<ol class="breadcrumb mb-4 mt-4">
    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Bienevenido">Inicio</a></li>
    <li class="breadcrumb-item active">Pago de Cuotas Publicidad</li>
</ol>

<!-- =========================================
 CONTENEDOR PRINCIPAL
========================================= -->
<div class="card shadow border-0">

    <!-- HEADER -->
    <div class="card-header text-white" style="background-color:#274DF5;">
        <i class="fas fa-credit-card me-2"></i> Registrar Pago de Publicidad
    </div>

    <div class="card-body">

        <!-- =========================================
        SELECCIÓN DE PROVEEDOR
        ========================================= -->
        <div class="row mb-3">
            <div class="col-md-4">
                <label>Proveedor</label>
                <div class="input-group">
                    <input type="text" id="txtProveedorSeleccionado" class="form-control" placeholder="-- Seleccione --" readonly>
                    <button class="btn btn-primary" type="button" id="btnAbrirModalProveedor">
                        <i class="fas fa-search"></i>
                    </button>
                </div>
                <input type="hidden" id="cmbProveedor">
            </div>
        </div>

        <!-- =========================================
         TABLA DE CUOTAS DISPONIBLES
        ========================================= -->
        <table class="table table-striped" id="tablaCuotas">
            <thead class="text-white" style="background-color:#274DF5;">
                <tr>
                    <th><input type="checkbox" id="chkTodos" /></th>
                    <th>Nº Campaña</th>
                    <th>Campaña</th>
                    <th>Proveedor</th>
                    <th>Cuota</th>
                    <th>Fecha Programada</th>
                    <th>Monto</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>

        <!-- BOTÓN PRINCIPAL -->
        <button id="btnPagar" class="btn btn-success mt-2">
            <i class="fas fa-check"></i> Registrar Pago
        </button>
    </div>
</div>

<!-- =========================================
MODAL DE SELECCIÓN DE PROVEEDOR
========================================= -->
<div class="modal fade" id="modalProveedores" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <!-- HEADER -->
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Seleccionar Proveedor</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <!-- BODY -->
            <div class="modal-body">

                <!-- BUSCADOR -->
                <div class="mb-2">
                    <input type="text" id="txtBuscarProveedor" class="form-control" placeholder="Buscar proveedor..." autocomplete="off">
                </div>

                <!-- TABLA PROVEEDORES -->
                <table class="table table-hover" id="tablaModalProveedores">
                    <thead>
                        <tr>
                            <th>Proveedor</th>
                            <th>Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Select(x => x.NombreProveedor).Distinct())
                        {
                            <tr>
                                <td>@p</td>
                                <td>
                                    <button class="btn btn-sm btn-success btnSeleccionarProveedor" data-nombre="@p">Seleccionar</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

            </div>
        </div>
    </div>
</div>

<!-- =========================================
MODAL PRINCIPAL DE PAGO
========================================= -->
<div class="modal fade" id="modalPago" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">

            <!-- HEADER -->
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Datos del Pago</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <!-- BODY -->
            <div class="modal-body">

                <!-- =========================================
                CUOTAS SELECCIONADAS
                ========================================= -->
                <h6 class="fw-bold text-primary">Cuotas Seleccionadas</h6>

                <div class="table-responsive mb-3">
                    <table class="table table-sm table-bordered" id="tablaCuotasSeleccionadas">
                        <thead class="table-primary text-center">
                            <tr>
                                <th>N° Campaña</th>
                                <th>Campaña</th>
                                <th>Proveedor</th>
                                <th>Cuota</th>
                                <th>Fecha</th>
                                <th class="text-end">Monto</th>
                            </tr>
                        </thead>
                        <tbody class="align-middle"></tbody>
                    </table>
                </div>

                <!-- TOTAL -->
                <div class="alert alert-success d-flex justify-content-between align-items-center">
                    <strong>Total a Pagar</strong>
                    <span id="lblTotal" class="fs-4 fw-bold" data-total="0"></span>
                </div>

                <hr>

                <!-- =========================================
                RETENCIONES
                ========================================= -->
                <h6 class="fw-bold text-danger">
                    <i class="fas fa-percentage me-1"></i> Retenciones
                </h6>

                <div class="row mb-2">
                    <div class="col-md-6">
                        <select id="cmbRetenciones" class="form-control">
                            <option value="">-- Seleccionar retención --</option>
                        </select>
                    </div>
                </div>

                <div id="contenedorRetenciones" class="mb-2"></div>

                <div class="alert alert-warning d-flex justify-content-between">
                    <strong>Total Retenciones</strong>
                    <span id="lblTotalRetenciones" data-total="0">C$0.00</span>
                </div>

                <div class="alert alert-primary d-flex justify-content-between">
                    <strong>Total Neto a Pagar</strong>
                    <span id="lblTotalNeto" data-total="0">C$0.00</span>
                </div>

                <hr class="my-4">

                <!-- =========================================
                 FORMAS DE PAGO
                ========================================= -->
                <h6 class="fw-bold text-secondary">
                    <i class="fas fa-file-invoice-dollar me-1"></i> Forma de Pago
                </h6>

                <table class="table" id="tablaPagosTipos">
                    <thead>
                        <tr>
                            <th>Tipo Documento</th>
                            <th>Monto</th>
                            <th>N° Confirmación</th>
                            <th>Comprobante</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>

                <!-- INPUTS PARA AGREGAR PAGOS -->
                <div class="row mb-3">
                    <div class="col-md-3">
                        <select id="cmbTipoDocAgregar" class="form-control">
                            <option value="">-- Seleccione Tipo --</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <input type="number" id="txtMontoAgregar" class="form-control" placeholder="Monto">
                    </div>
                    <div class="col-md-3">
                        <input type="text" id="txtNumeroConfirmacionAgregar" class="form-control" placeholder="N° Confirmación">
                    </div>
                    <div class="col-md-3">
                        <input type="file" id="fileComprobanteAgregar" class="form-control" accept=".jpg,.jpeg,.png,.pdf">
                    </div>
                    <div class="col-md-12 mt-2">
                        <button id="btnAgregarPago" class="btn btn-primary">Agregar Pago</button>
                    </div>
                </div>

                <!-- OBSERVACIÓN -->
                <label class="mt-2">Observación</label>
                <textarea id="txtObs" class="form-control"></textarea>

            </div>

            <!-- FOOTER -->
            <div class="modal-footer">
                <button id="btnConfirmarPago" class="btn btn-success">
                    Confirmar Pago
                </button>
            </div>
        </div>
    </div>
</div>

<!-- =========================================
MODAL MENSAJES / ERRORES
========================================= -->
<div class="modal fade" id="modalMensaje" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Mensaje</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="modalBody"></div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<!-- =========================================
MODAL DE ÉXITO
========================================= -->
<div class="modal fade" id="modalExito" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">Pago Registrado</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>El pago se registró correctamente.</p>
                <p><strong>Número de Documento:</strong> <span id="lblNumeroDoc"></span></p>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>


@section scripts{
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>

    <script>
        // ============================================
        //  SERIALIZACIÓN DE DATOS DESDE EL MODELO
        // ============================================
        const todasCuotas = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Model.Select(x => new {
                x.IdEstadoCuenta,
                x.IdCampania,
                x.NumeroCampania,
                x.NombreCampania,
                x.NombreProveedor,
                x.NumeroCuota,
                Fecha = x.FechaPagoProgramada.ToString("yyyy-MM-dd"),
                x.MontoCuota
            })
        ));

        // ============================================
        //  VARIABLES GLOBALES
        // ============================================
        let pagosTipos = [];

        // ============================================
        //  FUNCIONES UTILITARIAS
        // ============================================
        function fFecha(f){ return new Date(f).toLocaleDateString('es-NI'); }
        function fMonto(m){ return m.toLocaleString('es-NI',{style:'currency',currency:'NIO'}); }

        function mostrarModal(msg){
            $('#modalBody').text(msg);
            new bootstrap.Modal(document.getElementById('modalMensaje')).show();
        }

        // ============================================
        //  MODAL PROVEEDORES
        // ============================================

        // Abrir modal proveedores
        $('#btnAbrirModalProveedor').click(function(){
            new bootstrap.Modal(document.getElementById('modalProveedores')).show();
        });

        // Seleccionar proveedor desde modal
        $(document).on('click','.btnSeleccionarProveedor', function(){
            let prov = $(this).data('nombre');
            $('#txtProveedorSeleccionado').val(prov);
            $('#cmbProveedor').val(prov).trigger('change');
            bootstrap.Modal.getInstance(document.getElementById('modalProveedores')).hide();
        });

        // Filtrar proveedores en el modal
        $('#txtBuscarProveedor').on('keyup', function(){
            let texto = $(this).val().toLowerCase();
            $('#tablaModalProveedores tbody tr').each(function(){
                let nombre = $(this).find('td:first').text().toLowerCase();
                $(this).toggle(nombre.includes(texto));
            });
        });

        // ============================================
        //  CARGA DE CUOTAS POR PROVEEDOR
        // ============================================
        $('#cmbProveedor').change(function () {

            let prov = $(this).val();
            let tbody = $('#tablaCuotas tbody');

            tbody.empty();
            $('#chkTodos').prop('checked', false);

            if (!prov) return;

            let lista = todasCuotas.filter(x => x.NombreProveedor === prov);

            let grupos = {};

            lista.forEach(x => {
                if (!grupos[x.IdCampania]) grupos[x.IdCampania] = [];
                grupos[x.IdCampania].push(x);
            });

            for (let id in grupos) {

                let cuotas = grupos[id].sort((a, b) => a.NumeroCuota - b.NumeroCuota);

                let principal = cuotas[0];
                let restantes = cuotas.slice(1);

                // 🔹 FILA PRINCIPAL
                tbody.append(`
                <tr class="fila-principal" data-campania="${id}" style="cursor:pointer;">
                    <td></td>
                    <td>
                        <i class="fas fa-chevron-right me-1 toggle-icon"></i>
                        ${principal.NumeroCampania}
                    </td>
                    <td>${principal.NombreCampania}</td>
                    <td>${principal.NombreProveedor}</td>
                    <td>${principal.NumeroCuota}</td>
                    <td>${fFecha(principal.Fecha)}</td>
                    <td>${fMonto(principal.MontoCuota)}</td>
                </tr>
            `);

                // DETALLES OCULTOS
                restantes.forEach(e => {
                    tbody.append(`
                    <tr class="fila-detalle d-none" data-campania="${id}">
                        <td>
                            <input type="checkbox" class="chkCuota"
                                value="${e.IdEstadoCuenta}"
                                data-campania="${e.IdCampania}"
                                data-cuota="${e.NumeroCuota}"
                                data-monto="${e.MontoCuota}">
                        </td>
                        <td></td>
                        <td>${e.NombreCampania}</td>
                        <td>${e.NombreProveedor}</td>
                        <td>${e.NumeroCuota}</td>
                        <td>${fFecha(e.Fecha)}</td>
                        <td>${fMonto(e.MontoCuota)}</td>
                    </tr>
                `);
                });

                // CHECKBOX EN FILA PRINCIPAL
                tbody.find(`tr[data-campania="${id}"].fila-principal td:first`).html(`
                <input type="checkbox" class="chkCuota"
                    value="${principal.IdEstadoCuenta}"
                    data-campania="${principal.IdCampania}"
                    data-cuota="${principal.NumeroCuota}"
                    data-monto="${principal.MontoCuota}">
            `);
            }
        });

        // ============================================
        // RETENCIONES
        // ============================================

        // Cargar retenciones
        $.get('/TipoRetencion/Listar', function (res) {

            listaRetenciones = res;

            let cmb = $('#cmbRetenciones');
            cmb.empty().append('<option value="">-- Seleccionar retención --</option>');

            res.forEach(r => {
                cmb.append(`<option value="${r.id}" data-porcentaje="${r.porcentaje}">
              ${r.nombre} (${r.porcentaje}%)
             </option>`);
            });

        });

        $('#cmbRetenciones').change(function () {

            let id = $(this).val();
            if (!id) return;

            let option = $(this).find('option:selected');
            let nombre = option.text();
            let porcentaje = option.data('porcentaje');

            $('#contenedorRetenciones').append(`
                <div class="form-check retencion-item" data-id="${id}">
                    <input class="form-check-input chkRetencion"
                           type="checkbox"
                           checked
                           data-id="${id}"
                           data-porcentaje="${porcentaje}">

                    <label class="form-check-label">
                        ${nombre}
                    </label>
                </div>
            `);

            // eliminar del combo
            option.remove();

            $('#cmbRetenciones').val('');

            calcularRetenciones();

        });


        $(document).on('change', '.chkRetencion', function () {

            if (!$(this).is(':checked')) {

                let cont = $(this).closest('.retencion-item');

                let id = $(this).data('id');
                let porcentaje = $(this).data('porcentaje');
                let nombre = cont.find('label').text();

                $('#cmbRetenciones').append(`
                    <option value="${id}" data-porcentaje="${porcentaje}">
                        ${nombre}
                    </option>
                `);

                cont.remove();

            }

            calcularRetenciones();
        });

        // Evento cambio de retenciones
        $(document).on('change', '.chkRetencion', function () {
            calcularRetenciones();
        });


        // Cálculo de retenciones
        function calcularRetenciones() {

            let total = parseFloat($('#lblTotal').data('total')) || 0;
            let totalRetenciones = 0;

            $('.chkRetencion:checked').each(function () {
                let porcentaje = parseFloat($(this).data('porcentaje'));
                totalRetenciones += total * (porcentaje / 100);
            });

            let totalNeto = total - totalRetenciones;

            $('#lblTotalRetenciones')
                .data('total', totalRetenciones)
                .text(fMonto(totalRetenciones));

            $('#lblTotalNeto')
                .data('total', totalNeto)
                .text(fMonto(totalNeto));
        }

        // ============================================
        //  EXPANDIR / CONTRAER FILAS
        // ============================================
        $(document).on('click', '.fila-principal', function (e) {

            if ($(e.target).is('input')) return;

            let campania = $(this).data('campania');
            let icono = $(this).find('.toggle-icon');

            let filas = $(`tr.fila-detalle[data-campania="${campania}"]`);

            if (filas.hasClass('d-none')) {
                filas.removeClass('d-none');
                icono.removeClass('fa-chevron-right').addClass('fa-chevron-down');
            } else {
                filas.addClass('d-none');
                icono.removeClass('fa-chevron-down').addClass('fa-chevron-right');
            }
        });

        // ============================================
        // CARGAR CUOTAS EN MODAL
        // ============================================
        function cargarCuotasEnModal(seleccionadas) {

            let tbody = $('#tablaCuotasSeleccionadas tbody');
            tbody.empty();

            seleccionadas.each(function () {

                let fila = $(this).closest('tr');

                tbody.append(`
                    <tr>
                        <td>${fila.find('td:eq(1)').text()}</td>
                        <td>${fila.find('td:eq(2)').text()}</td>
                        <td>${fila.find('td:eq(3)').text()}</td>
                        <td>${fila.find('td:eq(4)').text()}</td>
                        <td>${fila.find('td:eq(5)').text()}</td>
                        <td class="text-end">${fila.find('td:eq(6)').text()}</td>
                    </tr>
                `);
            });
        }

        // ============================================
        //  SELECCIÓN GLOBAL DE CUOTAS
        // ============================================
        $('#chkTodos').click(function(){
            $('.chkCuota').prop('checked', this.checked);
        });

        // ============================================
        //  GESTIÓN DE PAGOS POR TIPO
        // ============================================
        $('#btnAgregarPago').click(function () {

            let editIndex = $(this).data('editando');

            let idTipo = $('#cmbTipoDocAgregar').val();
            let nombre = $('#cmbTipoDocAgregar option:selected').text();
            let monto = parseFloat($('#txtMontoAgregar').val());
            let numeroConfirmacion = $('#txtNumeroConfirmacionAgregar').val();
            let fileInput = document.getElementById('fileComprobanteAgregar');

            // VALIDACIONES
            if (!idTipo || !monto || monto <= 0) {
                mostrarModal('Seleccione tipo y monto válido');
                return;
            }

            if (!numeroConfirmacion) {
                mostrarModal('Debe ingresar N° Confirmación');
                return;
            }

            // EDICIÓN
            if (editIndex !== undefined) {

                let pagoExistente = pagosTipos[editIndex];

                let archivoFinal = fileInput.files.length > 0
                    ? fileInput.files[0]
                    : pagoExistente.file;

                if (!archivoFinal) {
                    mostrarModal('Debe seleccionar un comprobante');
                    return;
                }

                pagosTipos[editIndex] = {
                    id: idTipo,
                    nombre: nombre,
                    monto: monto,
                    numeroConfirmacion: numeroConfirmacion,
                    file: archivoFinal
                };

                $('#btnAgregarPago').removeData('editando');
                $('#btnAgregarPago').text('Agregar Pago');

            } else {

                // NUEVO
                if (!fileInput.files || fileInput.files.length === 0) {
                    mostrarModal('Debe seleccionar un comprobante');
                    return;
                }

                pagosTipos.push({
                    id: idTipo,
                    nombre: nombre,
                    monto: monto,
                    numeroConfirmacion: numeroConfirmacion,
                    file: fileInput.files[0]
                });
            }

            actualizarTablaPagos();

            $('#txtMontoAgregar').val('');
            $('#txtNumeroConfirmacionAgregar').val('');
            $('#fileComprobanteAgregar').val('');
        });



        function actualizarTablaPagos() {
            let tbody = $('#tablaPagosTipos tbody');
            tbody.empty();

            pagosTipos.forEach((p, i) => {

                let tieneArchivo = p.file ? true : false;

                tbody.append(`
                <tr>
                    <td>${p.nombre}</td>
                    <td>${fMonto(p.monto)}</td>
                    <td>${p.numeroConfirmacion}</td>
                    <td>
                        ${tieneArchivo
                        ? `<button class="btn btn-sm btn-info" onclick="verArchivo(${i})">
                                    <i class="fas fa-eye"></i>VER
                               </button>`
                        : `<span class="text-muted">Sin archivo</span>`
                    }
                    </td>
                       <td>
                            <div class="d-flex justify-content-center" style="gap:6px;">
                                <button class="btn btn-warning btn-sm" onclick="editarPago(${i})" title="Editar">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <button class="btn btn-danger btn-sm" onclick="eliminarPago(${i})" title="Eliminar">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </td>
                </tr>
            `);
            });
        }

        function verArchivo(index) {

            let file = pagosTipos[index].file;

            if (!file) {
                mostrarModal('No hay archivo disponible');
                return;
            }

            let url = URL.createObjectURL(file);

            window.open(url, '_blank');
        }

        function editarPago(index) {

            let pago = pagosTipos[index];

            // Cargar datos en inputs
            $('#cmbTipoDocAgregar').val(pago.id);
            $('#txtMontoAgregar').val(pago.monto);
            $('#txtNumeroConfirmacionAgregar').val(pago.numeroConfirmacion);

            // Guardamos índice en edición
            $('#btnAgregarPago').data('editando', index);

            // Opcional: cambiar texto botón
            $('#btnAgregarPago').text('Actualizar Pago');
        }

        function eliminarPago(i){ pagosTipos.splice(i,1); actualizarTablaPagos(); }

        // Botón Pagar -> abrir modal con validaciones existentes
        $('#btnPagar').click(function(){
            let seleccionadas = $('.chkCuota:checked');
            if(seleccionadas.length === 0){ mostrarModal('Seleccione al menos una cuota'); return; }

            // Validar consecutividad y cuotas pendientes
            let grupos = {};
            seleccionadas.each(function(){
                let campania = $(this).data('campania');
                if(!grupos[campania]) grupos[campania]=[];
                grupos[campania].push(parseInt($(this).data('cuota')));
            });

            for(let campania in grupos){
                let cuotas = grupos[campania].sort((a,b)=>a-b);
                let pendientes = $('.chkCuota')
                    .filter(function(){ return $(this).data('campania')==campania; })
                    .map(function(){ return parseInt($(this).data('cuota')); }).get()
                    .sort((a,b)=>a-b);

                for(let i=1; i<cuotas.length; i++){
                    if(cuotas[i] !== cuotas[i-1]+1){
                        mostrarModal('Las cuotas seleccionadas deben ser consecutivas dentro de la misma campaña.');
                        return;
                    }
                }

                let minSeleccionada = Math.min(...cuotas);
                let minPendiente = Math.min(...pendientes);
                if(minSeleccionada > minPendiente){

                    let numeroCampania = $('.chkCuota')
                        .filter(function(){ return $(this).data('campania') == campania; })
                        .first()
                        .closest('tr')
                        .find('td:eq(1)')
                        .text();

                    mostrarModal(`Debe incluir todas las cuotas pendientes anteriores (#${minPendiente}) de la campaña ${numeroCampania}`);
                    return;
                }

            }

           let total = 0;
            seleccionadas.each(function(){ total += parseFloat($(this).data('monto')); });

            $('#lblTotal').data('total', total);
            $('#lblTotal').text(fMonto(total));

            // RESET AQUÍ
            $('#lblTotalRetenciones').data('total', 0).text('C$0.00');
            $('#lblTotalNeto').data('total', total).text(fMonto(total));
            $('.chkRetencion').prop('checked', false);

            // NUEVO
            cargarCuotasEnModal(seleccionadas);

            // Cargar tipos de documento
            $.get('/TipoDocumentoPago/ListarTipos', function(res){
                $('#cmbTipoDocAgregar').empty().append('<option value="">-- Seleccione --</option>');
                res.forEach(t=>$('#cmbTipoDocAgregar').append(`<option value="${t.id}">${t.nombre}</option>`));
            });

            new bootstrap.Modal(document.getElementById('modalPago')).show();
        });


       // Confirmar Pago
       $('#btnConfirmarPago').click(async function() {

            let cuotasSeleccionadas = $('.chkCuota:checked');

            if(cuotasSeleccionadas.length === 0){
                mostrarModal('Seleccione al menos una cuota');
                return;
            }

           let totalNeto = parseFloat($('#lblTotalNeto').data('total'))
               || parseFloat($('#lblTotal').data('total'))
               || 0;

           // EL TOTAL REAL PAGADO (LA VERDAD DEL SISTEMA)
           let totalPagos = pagosTipos.reduce((s, x) => s + x.monto, 0);

           // STE ES EL QUE SE ENVÍA AL SP
           let totalAPagar = totalPagos;

           // VALIDACIÓN CORRECTA
           if (totalPagos < totalNeto) {
               mostrarModal('El monto pagado no puede ser menor al total neto a pagar');
               return;
           }
            // ================================
            //  VALIDAR ARCHIVOS (IMPORTANTE)
            // ================================
            for (let p of pagosTipos) {
                if (!p.file) {
                    mostrarModal(`El pago tipo "${p.nombre}" no tiene comprobante`);
                    return;
                }
            }

            // ================================
            //  RETENCIONES
            // ================================
            let retenciones = [];

           $('.chkRetencion:checked').each(function () {
               let porcentaje = parseFloat($(this).data('porcentaje'));
               let total = totalPagos; // CAMBIO CLAVE
               let monto = total * (porcentaje / 100);

               retenciones.push({
                   IdTipoRetencion: $(this).data('id'),
                   Porcentaje: porcentaje,
                   MontoRetenido: +monto.toFixed(2)
               });
           });

            // ================================
            //  DETALLE
            // ================================
            let detalleEnvio = [];
            let sumaCuotas = 0;
            let usuarioActual = '@ViewBag.UsuarioActual';

            cuotasSeleccionadas.each(function(){
                sumaCuotas += parseFloat($(this).data('monto'));
            });

            cuotasSeleccionadas.each(function(){

                let fila = $(this);
                let montoCuota = parseFloat(fila.data('monto'));
                let proporcion = montoCuota / sumaCuotas;

                pagosTipos.forEach(function(pago){

                    detalleEnvio.push({
                        IdEstadoCuenta: parseInt(fila.val()),
                        MontoPagado: +(pago.monto * proporcion).toFixed(2),
                        IdTipoDocumento: pago.id,
                        NumeroConfirmacion: pago.numeroConfirmacion,
                        RutaComprobante: pago.file ? pago.file.name : null,
                        UsuarioPago: usuarioActual
                    });

                });

            });

            // ================================
            //  FORM DATA
            // ================================
            let formData = new FormData();

            formData.append('IdCampania', cuotasSeleccionadas.first().data('campania'));
            formData.append('Observacion', $('#txtObs').val());
            formData.append('DetalleCuotas', JSON.stringify(detalleEnvio));
            formData.append('TotalAPagar', totalAPagar);
            formData.append('Retenciones', JSON.stringify(retenciones));

            pagosTipos.forEach((p,i)=>{
                if(p.file) formData.append(`PagosTipos[${i}].Comprobante`, p.file);
            });

            // ================================
            //  AJAX
            // ================================
            $.ajax({
                url:'/PagoPublicidad/RegistrarPagoMultiples',
                type:'POST',
                data: formData,
                processData:false,
                contentType:false,
                success:function(r){
                    if(r.success){
                        $('#lblNumeroDoc').text(r.numeroDocumento);
                        new bootstrap.Modal(document.getElementById('modalExito')).show();
                        setTimeout(() => location.reload(), 3000);
                    } else {
                        mostrarModal(r.mensajes.join("\n"));
                    }
                },
                error:function(){
                    mostrarModal('Error al registrar pago');
                }
            });

       });
    </script>
}
