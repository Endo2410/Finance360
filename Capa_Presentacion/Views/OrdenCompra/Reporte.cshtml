@model List<Capa_Entidad.OrdenCompra>

@{
    ViewData["Title"] = "Reporte de Órdenes de Compra";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Fechas para limitar el selector a los últimos 3 meses
    DateTime fechaHoy = DateTime.Today;
    DateTime fechaLimite = fechaHoy.AddMonths(-3);

    // Obtener rol del usuario desde sesión
    var rolUsuario = Context.Session.GetString("RolUsuario") ?? "";
}

<style>
    #tablaReporteOC thead th {
        border: none !important;
    }

    #tablaReporteOC {
        border-collapse: collapse !important;
    }

    .btn-mini {
        padding: 4px 8px !important;
        font-size: 13px !important;
    }

    .pagination {
        display: flex;
        justify-content: center;
        margin-top: 15px;
    }

        .pagination button {
            margin: 0 3px;
            padding: 4px 10px;
        }

    #noDataMessage {
        display: none;
        font-size: 16px;
        padding: 10px;
        color: red;
        font-weight: bold;
    }

    #mensajeFecha {
        font-weight: bold;
        font-size: 14px;
    }
</style>

<ol class="breadcrumb mb-4 mt-4">
    <li class="breadcrumb-item">
        <a asp-controller="Home" asp-action="Index">Inicio</a>
    </li>
    <li class="breadcrumb-item active">Reporte Órdenes de Compra</li>
</ol>

<div class="card shadow-sm border-0">
    <div class="card-header text-white d-flex justify-content-between align-items-center"
         style="background-color:#274DF5;">
        <div>
            <i class="fas fa-file-invoice me-2"></i>Reporte de Órdenes de Compra
        </div>
        <div class="d-flex flex-column">
            <div class="d-flex align-items-center mb-1">
                <input type="date" id="fechaInicio"
                       class="form-control form-control-sm me-2"
                       value="@ViewBag.FechaInicio"
                       min="@fechaLimite.ToString("yyyy-MM-dd")"
                       max="@fechaHoy.ToString("yyyy-MM-dd")" />

                <input type="date" id="fechaFin"
                       class="form-control form-control-sm me-2"
                       value="@ViewBag.FechaFin"
                       min="@fechaLimite.ToString("yyyy-MM-dd")"
                       max="@fechaHoy.ToString("yyyy-MM-dd")" />

                <button class="btn btn-light btn-sm btn-mini me-2"
                        onclick="filtrarReporte()">
                    <i class="fas fa-search"></i>
                </button>

               @*  <button class="btn btn-danger btn-sm btn-mini"
                        onclick="exportarPDF()">
                    <i class="fas fa-file-pdf"></i>
                </button> *@
            </div>

            <!-- Mensaje de error debajo de los inputs -->
            <div id="mensajeFecha" class="text-danger" style="display:none;">
                Solo se permiten fechas de los últimos 3 meses.
            </div>
        </div>
    </div>

    <div class="card-body bg-white">

        <!-- FILTRO POR COLUMNA -->
        <div class="row mt-3 mb-3">
            <div class="col-md-3">
                <select id="filtroCampo" class="form-control">
                    <option value="">-- Seleccionar campo --</option>
                    <option value="0">Proveedor</option>
                    @if (rolUsuario != "CONSULTOR")
                    {
                        <option value="1">N° Orden</option>
                    }
                    <option value="2">Estado</option>
                    <option value="3">Factura</option>
                    <option value="4">Observaciones</option>
                    <option value="5">Fecha Creación</option>
                </select>
            </div>

            <div class="col-md-4">
                <input id="filtroValor"
                       class="form-control"
                       placeholder="Buscar..."
                       onkeyup="filtrarColumna()" />
            </div>
        </div>

        <div id="noDataMessage">No hay datos para mostrar</div>

        <table id="tablaReporteOC"
               class="table table-striped table-bordered align-middle">
            <thead style="background-color:#274DF5;color:white;">
                <tr>
                    <th>Proveedor</th>
                    @if (rolUsuario != "CONSULTOR")
                    {
                        <th>N° Orden</th>
                    }
                    <th>Estado</th>
                    <th>Factura</th>
                    <th>Observaciones</th>
                    <th>Fecha Creación</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in Model)
                {
                    <tr>
                        <td>@o.Proveedor</td>
                        @if (rolUsuario != "CONSULTOR")
                        {
                            <td>@o.NumeroOrden</td>
                        }
                        <td>@o.Estado</td>
                        <td>@o.Confirmacion</td>
                        <td>@o.Observaciones</td>
                        <td>@o.FechaCreacion.ToString("dd/MM/yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>

    </div>
</div>

@section scripts {
    <script>
        var rolUsuario = '@rolUsuario';

        $(document).ready(function () {
            var table = $('#tablaReporteOC').DataTable({
                pageLength: 10,
                lengthChange: false,
                ordering: false,
                responsive: true,
                language: {
                    paginate: { previous: "Anterior", next: "Siguiente" },
                    info: "Mostrando _START_ a _END_ de _TOTAL_ entradas",
                    infoEmpty: "Mostrando 0 a 0 de 0 entradas",
                    emptyTable: "No hay datos para mostrar"
                }
            });

            $('#tablaReporteOC_filter').hide();

            $("#filtroCampo, #filtroValor").on("change keyup", function () {
                var colIndex = $("#filtroCampo").val();
                var value = $("#filtroValor").val();

                table.columns().search('');

                if (colIndex !== "") {
                    // CONSULTOR no puede filtrar por N° Orden (colIndex = 1)
                    if (rolUsuario === "CONSULTOR" && colIndex == 1) return;

                    table.column(colIndex).search(value).draw();
                } else {
                    table.rows().every(function () {
                        var rowText = $(this.node()).text().toLowerCase();
                        $(this.node()).toggle(rowText.indexOf(value.toLowerCase()) > -1);
                    });
                    table.draw(false);
                }
            });
        });

        function filtrarReporte() {
            const inicio = new Date($('#fechaInicio').val());
            const fin = new Date($('#fechaFin').val());
            const hoy = new Date();
            const limite = new Date();
            limite.setMonth(limite.getMonth() - 3);

            const mensajeDiv = $('#mensajeFecha');
            mensajeDiv.hide(); // Oculta mensaje por defecto

            if (!inicio || !fin) {
                mensajeDiv.text("Seleccione un rango de fechas válido.").show();
                return;
            }

            if (inicio < limite || fin > hoy) {
                mensajeDiv.text("Solo se permiten fechas de los últimos 3 meses.").show();
                return;
            }

            if (inicio > fin) {
                mensajeDiv.text("La fecha de inicio no puede ser mayor a la fecha fin.").show();
                return;
            }

            window.location.href =
                `@Url.Action("Reporte", "OrdenCompra")?fechaInicio=${inicio.toISOString().slice(0,10)}&fechaFin=${fin.toISOString().slice(0,10)}`;
        }

        function exportarPDF() {
            const inicio = $('#fechaInicio').val();
            const fin = $('#fechaFin').val();
            const campo = $("#filtroCampo").val();
            const valor = $("#filtroValor").val();

            window.open(
                `@Url.Action("ExportarPDF", "OrdenCompra")?fechaInicio=${inicio}&fechaFin=${fin}&campo=${campo}&valor=${valor}`,
                "_blank"
            );
        }
    </script>
}
