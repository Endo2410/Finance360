@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>CambiarClave</title>
    <link href="~/Content/Site.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link href="~/Content/DataTables/css/loadingoverlaylogin.css" rel="stylesheet" />
    <link href="~/css/nuevo.css" rel="stylesheet" />
    <link href="~/css/login01.css" rel="stylesheet" />
    <link href="~/css/REGISTRO.css" rel="stylesheet" />
</head>
<body>

    <section class="vh-100 vw-100">

        <div>


            <div class="container register text-center">
                <div class="row">
                    <div class="col-md-3 register-left">

                        <img src="~/img/logo.png" alt="logo" style="width:200px;" />

                        <input type="button" value="Iniciar Sesión" class="btn btn-primary" onclick="location.href='@Url.Action("Index", "Acceso")'">

                    </div>
                    <div class="col-md-9 register-right">
                        <div class="container">
                            <div class="tab-content">
                                <div class="tab-pane fade show active" id="home">
                                    <h3 class="register-heading">CAMBIAR CONTRASEÑA!</h3>
                                    <form action="@Url.Action("CambiarClave","Acceso")" method="post">

                                        <input class="form-control" type="hidden" value="@TempData["IDUSUARIO"]" name="idusuario" />
                                        <div class="row mb-3">
                                            <div class="col-md-12">
                                                <div class="form-floating mb-3 mb-md-0">
                                                    <input class="form-control input-full" id="inputPassword" type="password" autocomplete="off" name="claveactual" value="@ViewData["vclave"]" />
                                                    <label for="inputPassword">Contraseña Actual</label>
                                                </div>
                                            </div>

                                        </div>

                                        <div class="row mb-3">
                                            <div class="col-md-12">
                                                <div class="form-floating mb-3 mb-md-0">
                                                    <input class="form-control" id="inputPassword" type="password" autocomplete="off" name="nuevaclave" />
                                                    <label for="inputPassword">Nueva Contraseña</label>
                                                </div>
                                            </div>

                                        </div>

                                        <div class="row mb-3">
                                            <div class="col-md-12">
                                                <div class="form-floating mb-3 mb-md-0">
                                                    <input class="form-control" id="inputPassword" type="password" autocomplete="off" name="confirmarclave" />
                                                    <label for="inputPassword">Confirmar Nueva Contraseña</label>
                                                </div>
                                            </div>

                                        </div>
                                        @{
                                            if (ViewBag.Error != null)
                                            {
                                                <div class="form-floating mb-3">
                                                    <div class="alert alert-danger" role="alert">
                                                        @ViewBag.Error
                                                    </div>
                                                </div>
                                            }

                                        }
                                        <div class="mt-4 mb-0">
                                            <div class="d-grid"><button type="submit" class="btn btn-primary btn-block">Cambiar Contraseña</button></div>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>


            </div>





        </div>

    </section>
    <footer class="text-center py-3 bg-primary text-white footer">
        Farmacia Saba © @DateTime.Now.Year . Todos los derechos reservados. - Desarrollado por Ing. José Luis López 
    </footer>

</body>
</html>
