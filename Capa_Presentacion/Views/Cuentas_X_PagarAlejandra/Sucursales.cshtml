@using System.Text.Json
@model List<Capa_Entidad.Contabilidad_Alejandra.E_Sucursales>

@{
    ViewData["Title"] = "Sucursales";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<ol class="breadcrumb mb-4 mt-4">
    <li class="breadcrumb-item active">Gestion General</li>
</ol>

<div class="row">
    <!-- Sucursales -->
    <div class="col-md-3 mb-2">
        <a asp-controller="Cuentas_X_PagarAlejandra" asp-action="Sucursales" class="text-decoration-none">
            <div class="card shadow h-100 border-0">
                <div class="card-body text-center">
                    <i class="fas fa-store fa-2x text-primary"></i>
                    <h6 class="mt-2">Sucursales</h6>
                </div>
            </div>
        </a>
    </div>

    <!-- Proveedores -->
    <div class="col-md-3 mb-2">
        <a asp-controller="Proveedores" asp-action="Index" class="text-decoration-none">
            <div class="card shadow h-100 border-0">
                <div class="card-body text-center">
                    <i class="fas fa-truck fa-2x text-success"></i>
                    <h6 class="mt-2">Proveedores</h6>
                </div>
            </div>
        </a>
    </div>


    <!-- Departamento -->
    <div class="col-md-3 mb-2">
        <a asp-controller="Proveedores" asp-action="Departamento" class="text-decoration-none">
            <div class="card shadow h-100 border-0">
                <div class="card-body text-center">
                    <i class="fas fa-building fa-2x text-warning"></i>
                    <h6 class="mt-2">Departamento</h6>
                </div>
            </div>
        </a>
    </div>

</div>



<ol class="breadcrumb mb-4 mt-4">
    <li class="breadcrumb-item">
        <a asp-controller="Home" asp-action="Index">Inicio</a>
    </li>
    <li class="breadcrumb-item active">Sucursales</li>
</ol>



<div class="card shadow border-0">
    <div class="card-header text-white d-flex justify-content-between align-items-center"
         style="background-color:#274DF5;">
        <div>
            <i class="fas fa-truck me-2"></i> Lista de Sucursales
        </div>

        <button class="btn btn-light btn-sm"
                onclick="abrirConfirmacion()">
            <i class="fas fa-sync-alt"></i> Importar Sucursales
        </button>
    </div>



    <!-- TABLA -->
    <div class="card-body">
        <table class="table table-striped align-middle" id="tablaSucursales">
            <thead class="text-white" style="background-color:#274DF5;">
                <tr>
                    <th>ID</th>
                    <th>NOMBRE SUCURSAL</th>
                    <th>NUMERO SUCURSAL</th>

                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>@p.IdSucursal</td>
                        <td>@p.NombreSucursal</td>
                        <td>@p.Codigo</td>

                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- ================= MODAL CONFIRMACION ================= -->
<div class="modal fade" id="modalConfirmSync" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark py-2">
                <h6 class="modal-title w-100 text-center">
                    <i class="fas fa-question-circle"></i> Confirmación
                </h6>
            </div>
            <div class="modal-body text-center">
                <p class="mb-3">¿Desea sincronizar las sucursales?</p>

                <button class="btn btn-secondary btn-sm me-2"
                        data-bs-dismiss="modal">
                    Cancelar
                </button>
                <button class="btn btn-primary btn-sm"
                        onclick="confirmarSincronizacion()">
                    Sí, sincronizar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ================= MODAL RESULTADO ================= -->
<div class="modal fade" id="modalSync" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header bg-success text-white py-2">
                <h6 class="modal-title w-100 text-center">
                    <i class="fas fa-check-circle"></i> Sincronización
                </h6>
            </div>
            <div class="modal-body text-center">
                <p id="mensajeSync" class="mb-0"></p>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />

    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

    <script>
        let tablaSucursales;

        $(document).ready(function () {

            // Clonar encabezado para filtros
            $('#tablaSucursales thead tr').clone(true).appendTo('#tablaSucursales thead');

            $('#tablaSucursales thead tr:eq(1) th').each(function (i) {
                $(this).html('<input type="text" placeholder="Buscar" style="width:100%;" />');

                $('input', this).on('keyup change', function () {
                    if (tabla.column(i).search() !== this.value) {
                        tabla.column(i).search(this.value).draw();
                    }
                });
            });

            // Inicializar DataTable
            var tabla = $('#tablaSucursales').DataTable({
                orderCellsTop: true,
                fixedHeader: true,
                language: {
                    url: "//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json"
                }
            });

        });


        function abrirConfirmacion() {
            new bootstrap.Modal(
                document.getElementById('modalConfirmSync')
            ).show();
        }

        function confirmarSincronizacion() {

            bootstrap.Modal
                .getInstance(document.getElementById('modalConfirmSync'))
                .hide();

            $.ajax({
            url: '@Url.Action("Sincronizar", "Cuentas_X_PagarAlejandra")',

                type: 'POST',
                success: function (data) {

                    $("#mensajeSync").html(
                        `<strong>Actualizados:</strong> ${data.actualizados}<br>
                         <strong>Insertados:</strong> ${data.insertados}`
                    );


                    let modal = new bootstrap.Modal(
                        document.getElementById('modalSync')
                    );
                    modal.show();

                    setTimeout(() => {
                        modal.hide();
                        location.reload();
                    }, 2000);
                },
                error: function () {
                    $("#mensajeSync").text("Error al sincronizar proveedores");
                    new bootstrap.Modal(
                        document.getElementById('modalSync')
                    ).show();
                }
            });
        }
    </script>
}

