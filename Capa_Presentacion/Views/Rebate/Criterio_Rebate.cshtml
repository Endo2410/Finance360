@using System.Text.Json
@model List<Capa_Entidad.CE_Rebate.CriterioRebate>

@{
    ViewData["Title"] = "Gestión de Criterios Rebate";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<ol class="breadcrumb mb-4 mt-4">
    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Bienvenido">Inicio</a></li>
    <li class="breadcrumb-item active">Criterios Rebate</li>
</ol>

<div class="card shadow border-0">
    <div class="card-header text-white d-flex justify-content-between align-items-center" style="background-color:#274DF5;">
        <span><i class="fas fa-balance-scale me-2"></i>Lista de Criterios</span>
        <button id="btnNuevo" class="btn btn-light btn-sm">
            <i class="fas fa-plus"></i> Nuevo Criterio
        </button>
    </div>

    <div class="card-body">
        <table class="table table-striped align-middle" id="tablaCriterios">
            <thead class="text-white" style="background-color:#274DF5;">
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Operador</th>
                    <th>Descripción</th>
                    <th>Estado</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    var json = JsonSerializer.Serialize(new
                    {
                        c.IdCriterio,
                        c.Nombre,
                        c.Operador,
                        c.Descripcion,
                        IdEstado = c.oEstado?.IdEstado ?? 0
                    });

                    <tr>
                        <td>@c.IdCriterio</td>
                        <td>@c.Nombre</td>
                        <td>@c.Operador</td>
                        <td>@c.Descripcion</td>
                        <td>@c.oEstado?.Nombre</td>
                        <td class="text-center">
                            <button class="btn btn-warning btn-sm" onclick='abrirModal(@Html.Raw(json))'>
                                <i class="fas fa-edit"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="modalCriterio" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Criterio Rebate</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <form id="formCriterio" autocomplete="off">
                    <input type="hidden" id="txtid" value="0" />

                    <div class="mb-3">
                        <label class="form-label">Nombre</label>
                        <input id="txtnombre" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Operador</label>
                        <input id="txtoperador" class="form-control" required placeholder=">, >=, +, %" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Descripción</label>
                        <textarea id="txtdescripcion" class="form-control" rows="2" required></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Estado</label>
                        <select id="cboestado" class="form-select"></select>
                    </div>

                    <div class="mt-3">
                        <div class="alert alert-danger d-none" id="mensajeError"></div>
                    </div>
                </form>
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button class="btn btn-primary" onclick="guardarCriterio()">Guardar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal global de éxito y error (igual que los otros módulos) -->
<div class="modal fade" id="modalExito" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">Éxito</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="cuerpoExito"></div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalMensaje" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Error</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="cuerpoMensaje"></div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            cargarEstados();
            $('#btnNuevo').click(() => abrirModal());
        });

        function abrirModal(c = null) {
            $('#mensajeError').addClass('d-none').text('');
            $('#formCriterio')[0].reset();
            $('#txtid').val(c ? c.IdCriterio : 0);

            if (c) {
                $('#txtnombre').val(c.Nombre);
                $('#txtoperador').val(c.Operador);
                $('#txtdescripcion').val(c.Descripcion);
                $('#cboestado').val(c.IdEstado);
            }

            new bootstrap.Modal('#modalCriterio').show();
        }

        function cargarEstados() {
            $.get('/Estado/ListarEstado', data => {
                $('#cboestado').empty();

                if (data.success) {
                    data.estados.forEach(e => {
                        $('#cboestado').append(`<option value="${e.idEstado}">${e.nombre}</option>`);
                    });
                } else {
                    let errores = data.mensajes ? data.mensajes.join('<br/>') : 'No se pudieron cargar los estados.';
                    $('#cuerpoMensaje').html(errores);
                    new bootstrap.Modal('#modalMensaje').show();
                }
            });
        }

        function guardarCriterio() {
            let criterio = {
                IdCriterio: $('#txtid').val(),
                Nombre: $('#txtnombre').val(),
                Operador: $('#txtoperador').val(),
                Descripcion: $('#txtdescripcion').val(),
                IdEstado: $('#cboestado').val()
            };

            let url = criterio.IdCriterio == 0 ? '/Rebate/CrearCriterio' : '/Rebate/EditarCriterio';

            $.post(url, criterio, res => {
                $('#mensajeError').addClass('d-none').html('');

                if (res.success) {
                    bootstrap.Modal.getInstance(document.getElementById('modalCriterio')).hide();
                    $('#cuerpoExito').html(res.mensajes.join('<br/>'));
                    new bootstrap.Modal('#modalExito').show();
                    setTimeout(() => location.reload(), 1500);
                } else {
                    let htmlErrores = res.mensajes && res.mensajes.length > 0
                        ? res.mensajes.map(m => `<p>${m}</p>`).join('')
                        : '<p>Ocurrió un error inesperado.</p>';

                    $('#mensajeError').removeClass('d-none').html(htmlErrores);
                }
            });
        }
    </script>
}
