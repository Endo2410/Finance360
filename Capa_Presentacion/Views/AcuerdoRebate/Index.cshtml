@using System.Text.Json
@model List<Capa_Entidad.AcuerdoRebate>

@{
    ViewData["Title"] = "Gestión de Acuerdos Rebate";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    var jsonAcciones = Context.Session.GetString("AccionesUsuario");
    var acciones = !string.IsNullOrEmpty(jsonAcciones)
        ? JsonSerializer.Deserialize<List<string>>(jsonAcciones)
        : new List<string>();

    bool puedeCrear = acciones.Contains("Crear_Acuerdo_Rebate");
    bool puedeEditar = acciones.Contains("Editar_Acuerdo_Rebate");
}


<!-- Breadcrumb -->
<ol class="breadcrumb mb-4 mt-4">
    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
    <li class="breadcrumb-item active">Acuerdos Rebate</li>
</ol>

<!-- Card principal -->
<div class="card shadow border-0">
    <div class="card-header text-white d-flex justify-content-between align-items-center"
         style="background-color:#274DF5;">
        <span><i class="fas fa-file-contract me-2"></i> Lista de Acuerdos Rebate</span>
        @if (puedeCrear)
        {
            <button id="btnNuevo" class="btn btn-light btn-sm">
                <i class="fas fa-plus"></i> Nuevo Acuerdo
            </button>
        }
    </div>

    <div class="card-body">

        <!-- Filtro por columna -->
        <div class="row mb-3">
            <div class="col-md-3">
                <select id="filtroCampo" class="form-control">
                    <option value="">-- Filtrar por --</option>
                    <option value="1">Nº Acuerdo</option>
                    <option value="2">Nombre</option>
                    <option value="3">Proveedor</option>
                    <option value="4">Modalidad</option>
                    <option value="5">Tipo Rebate</option>
                    <option value="6">Criterio</option>
                    <option value="7">Valor</option>
                    <option value="8">País</option>
                    <option value="9">Moneda</option>
                    <option value="10">Fecha Inicio</option>
                    <option value="11">Fecha Fin</option>
                    <option value="12">Estado</option>
                </select>
            </div>
            <div class="col-md-4">
                <input id="filtroValor" class="form-control" placeholder="Buscar..." autocomplete="off" onkeyup="filtrarColumna()" />
            </div>
        </div>

        <table class="table table-striped align-middle" id="tablaAcuerdos">
            <thead class="text-white" style="background-color:#274DF5;">
                <tr>
                    <th style="display:none;">ID</th>
                    <th>Nº Acuerdo</th>
                    <th>Nombre</th>
                    <th>Proveedor</th>
                    <th>Modalidad</th>
                    <th>Tipo Rebate</th>
                    <th>Criterio</th>
                    <th>Valor</th>
                    <th>Ganancia</th>
                    <th>País</th>
                    <th>Moneda</th>
                    <th>Fecha Inicio</th>
                    <th>Fecha Fin</th>
                    <th>Usuario Registro</th>
                    <th>Documento</th>
                    <th>Estado</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model)
                {
                    var json = JsonSerializer.Serialize(new
                    {
                        a.IdAcuerdo,
                        a.NombreAcuerdo,
                        IdProveedor = a.oProveedor?.IdProveedor ?? 0,
                        NombreProveedor = a.oProveedor?.NombreProveedor ?? "",
                        IdModalidadOp = a.oModalidadOperacion?.IdModalidadOp ?? 0,
                        IdTipoRebate = a.oTipoRebate?.IdTipoRebate ?? 0,
                        IdCriterio = a.oCriterio?.IdCriterio ?? 0,
                        a.ValorCriterio,
                        a.Ganancia,
                        IdPais = a.oPais?.IdPais ?? 0,
                        IdMoneda = a.oMoneda?.IdMoneda ?? 0,
                        FechaInicio = a.FechaInicio.ToString("yyyy-MM-dd"),
                        FechaFin = a.FechaFin.ToString("yyyy-MM-dd"),
                        UsuarioCreacion = a.UsuarioCreacion,
                        Documento = a.Documento,
                        a.Comentario,
                        IdEstado = a.oEstado?.IdEstado ?? 0
                    });

                    <tr>
                        <td style="display:none;">@a.IdAcuerdo</td>
                        <td>@a.NumeroAcuerdo</td>
                        <td>@a.NombreAcuerdo</td>
                        <td>@a.oProveedor?.NombreProveedor</td>
                        <td>@a.oModalidadOperacion?.Nombre</td>
                        <td>@a.oTipoRebate?.Nombre</td>
                        <td>@a.oCriterio?.Nombre</td>
                        <td>@a.ValorCriterio.ToString("N2")</td>
                        <td>@a.Ganancia.ToString("N2")</td>
                        <td>@a.oPais?.Nombre</td>
                        <td>@a.oMoneda?.Nombre</td>
                        <td>@a.FechaInicio.ToString("yyyy-MM-dd")</td>
                        <td>@a.FechaFin.ToString("yyyy-MM-dd")</td>
                        <td>@a.UsuarioCreacion</td> <!-- nuevo -->
                        <td>
                            @if (!string.IsNullOrEmpty(a.Documento))
                            {
                                <a href="@Url.Content($"~/archivo/acuerdos/{a.Documento}")" target="_blank" class="btn btn-sm btn-secondary">
                                    <i class="fas fa-file"></i> Ver
                                </a>
                            }
                        </td>
                        <td>
                            @if (a.oEstado.IdEstado == 3)
                            {
                                <span class="badge bg-success">CREADO</span>
                            }
                            else if (a.oEstado.IdEstado == 4)
                            {
                                <span class="badge bg-danger">FINALIZADO</span>
                            }
                        </td>
                        <td class="text-center">
                            @{
                                bool esFinalizado = a.oEstado?.IdEstado == 4;
                            }

                            @if (esFinalizado)
                            {
                                <!-- Siempre solo lectura -->
                                <button class="btn btn-info btn-sm btn-editar"
                                        data-json='@Html.Raw(json)'>
                                    <i class="fas fa-eye"></i> Ver
                                </button>
                            }
                            else
                            {
                                if (puedeEditar)
                                {
                                    <!-- Puede editar -->
                                    <button class="btn btn-warning btn-sm btn-editar"
                                            data-json='@Html.Raw(json)'>
                                        <i class="fas fa-edit"></i> Editar
                                    </button>
                                }
                                else
                                {
                                    <!-- No puede editar → solo ver -->
                                    <button class="btn btn-info btn-sm btn-editar"
                                            data-json='@Html.Raw(json)'>
                                        <i class="fas fa-eye"></i> Ver
                                    </button>
                                }
                            }

                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Crear/Editar Acuerdo -->
<div class="modal fade" id="modalAcuerdo" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Acuerdo Rebate</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <input type="hidden" id="txtid" value="0" />
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Nombre Acuerdo</label>
                        <input id="txtnombre" class="form-control" autocomplete="off" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Proveedor</label>
                        <div class="input-group">
                            <input type="hidden" id="cboproveedor" />
                            <input id="txtProveedorNombre" class="form-control" placeholder="Seleccionar proveedor" readonly>
                            <button class="btn btn-secondary" type="button" onclick="abrirModalProveedor()">Buscar</button>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Modalidad Operación</label>
                        <select id="cbomodalidad" class="form-select"></select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Tipo Rebate</label>
                        <select id="cbotiporebate" class="form-select"></select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">País</label>
                        <select id="cbopais" class="form-select"></select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Moneda</label>
                        <select id="cbomoneda" class="form-select"></select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Criterio</label>
                        <select id="cbocriterio" class="form-select"></select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Valor Criterio</label>
                        <div class="input-group">
                            <span class="input-group-text" id="spanSimbolo">C$</span>
                            <input id="txtvalor" type="number" step="0.01" class="form-control" autocomplete="off" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Ganancia</label>
                        <div class="input-group">
                            <input id="txtganancia" class="form-control" autocomplete="off" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Fecha Inicio</label>
                        <input id="txtinicio" type="date" class="form-control" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Fecha Fin</label>
                        <input id="txtfin" type="date" class="form-control" />
                    </div>

                    <div class="col-12">
                        <label class="form-label">Comentario</label>
                        <textarea id="txtcomentario" class="form-control" autocomplete="off"></textarea>
                    </div>


                    <div class="col-md-6">
                        <label class="form-label">Documento Adjunto</label>
                        <input type="file" id="archivo" class="form-control" />
                        <div id="archivoExistente" class="mt-1"></div>
                    </div>

                    <div class="col-md-6" id="contenedorPreviewAcuerdo" style="display:none;">
                        <label class="form-label">Vista previa</label>
                        <div class="border rounded p-2 text-center">
                            <button id="btnPreviewAcuerdo" class="btn btn-outline-primary btn-sm" type="button">
                                <i class="fas fa-eye"></i> Ver archivo
                                </a>
                            </button>
                        </div>
                    </div>
                   

                    <div class="col-12">
                        <div class="alert alert-danger d-none" id="mensajeError"></div>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button class="btn btn-primary" onclick="guardarAcuerdo()">Guardar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Selección de Proveedor -->
<div class="modal fade" id="modalProveedor" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Seleccionar Proveedor</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <input type="text" id="txtFiltrarProveedor" class="form-control" placeholder="Filtrar proveedor por nombre o RUC">
                </div>
                <table class="table table-striped table-hover" id="tablaProveedores">
                    <thead>
                        <tr>
                            <th>RUC</th>
                            <th>Nombre</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Se llena dinámicamente -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal global para mensajes de éxito -->
<div class="modal fade" id="modalExito" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">Éxito</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="cuerpoExito"></div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal global para errores inesperados -->
<div class="modal fade" id="modalMensaje" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Error</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="cuerpoMensaje"></div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#tablaAcuerdos').DataTable({
                pageLength: 15,
                lengthChange: false,
                searching: false,
                ordering: false,
                responsive: true,
                language: {
                    paginate: { previous: "Anterior", next: "Siguiente" },
                    info: "Mostrando _START_ a _END_ de _TOTAL_ registros",
                    emptyTable: "No hay acuerdos registrados"
                },
                    columnDefs: [
                    { targets: [9, 10], visible: false } // Oculta País (9) y Moneda (10)
                ]
            });

            cargarModalidades();
            cargarTipoRebate();
            cargarCriterios();
            cargarPaises();
            cargarMonedas();

            $('#btnNuevo').click(() => abrirModal());
        });

        // FILTRO MANUAL POR COLUMNA
        function filtrarColumna() {
            let campoIndex = $('#filtroCampo').val();
            let valor = $('#filtroValor').val().toLowerCase();
            $('#tablaAcuerdos tbody tr').each(function () {
                if (campoIndex === "") { $(this).show(); return; }
                let textoCelda = $(this).find('td').eq(campoIndex).text().toLowerCase();
                $(this).toggle(textoCelda.includes(valor));
            });
        }

        $('#filtroCampo').change(function () {
            $('#filtroValor').val('');
            filtrarColumna();
        });


        function previsualizarArchivoAcuerdo() {
            let input = document.getElementById('archivo');
            let contenedor = document.getElementById('contenedorPreviewAcuerdo');
            let preview = document.getElementById('previewArchivo');

            preview.innerHTML = ''; // Limpiar previo

            if (input.files.length === 0) {
                contenedor.style.display = 'none';
                return;
            }

            let file = input.files[0];
            let url = URL.createObjectURL(file);

            if (file.type === "application/pdf") {
                preview.innerHTML = `<iframe src="${url}" width="100%" height="300px"></iframe>`;
            } else if (file.type.startsWith("image/")) {
                preview.innerHTML = `<img src="${url}" class="img-fluid" />`;
            } else {
                preview.innerHTML = `<p>No se puede previsualizar este tipo de archivo.</p>`;
            }

            contenedor.style.display = 'block';
        }


        // Abrir modal para editar
        $('#tablaAcuerdos').on('click', '.btn-editar', function () {
            let data = $(this).attr('data-json');
            let c = JSON.parse(data);

            let modo = c.IdEstado === 4 ? "lectura" : "editar";

            abrirModal(c, modo);
        });


        async function abrirModal(c = null, modo = "crear"){
            $('#mensajeError, #mensajeOk').addClass('d-none').text('');
            $('#formAcuerdo')[0]?.reset();
            $('#archivoExistente').data('nombre','');
            $('#contenedorPreviewAcuerdo').hide();

            $('#txtid').val(c ? c.IdAcuerdo : 0);
            $('#txtUsuarioRegistro').val(c ? c.UsuarioCreacion : '@User.Identity.Name');
            $('#txtnombre').val(c?.NombreAcuerdo ?? '');
            $('#txtProveedorNombre').val(c?.NombreProveedor ?? '');
            $('#txtvalor').val(c?.ValorCriterio ?? '');
            $('#txtganancia').val(c?.Ganancia ?? '');
            $('#txtinicio').val(c?.FechaInicio ?? '');
            $('#txtfin').val(c?.FechaFin ?? '');
            $('#txtcomentario').val(c?.Comentario ?? '');

            // Cargar combos
            await Promise.all([
                cargarCombo('#cbomodalidad', '/ModalidadOperacion/Listar', c?.IdModalidadOp),
                cargarCombo('#cbotiporebate', '/TipoRebate/Listar', c?.IdTipoRebate),
                cargarCombo('#cbocriterio', '/CriterioRebate/Listar', c?.IdCriterio),
                cargarCombo('#cbopais', '/Pais/ListarPaises', c?.IdPais),
                cargarCombo('#cbomoneda', '/Moneda/ListarMonedas', c?.IdMoneda, true)
            ]);

            $('#cboproveedor').val(c?.IdProveedor ?? 0);

            // Si hay archivo existente
            if(c?.Documento){
                $('#archivoExistente').data('nombre', c.Documento);
                $('#contenedorPreviewAcuerdo').show();

                $('#btnPreviewAcuerdo').off('click').on('click', function(){
                    const url = `/archivo/acuerdos/${c.Documento}`;
                    window.open(url, '_blank');
                });
            }

            // Si selecciona un nuevo archivo
            $('#archivo').off('change').on('change', function(){
                const file = this.files[0];
                if(file){
                    $('#archivoExistente').data('nombre','');
                    $('#contenedorPreviewAcuerdo').show();

                    $('#btnPreviewAcuerdo').off('click').on('click', function(){
                        const url = URL.createObjectURL(file);
                        window.open(url, '_blank');
                    });
                } else {
                    if(c?.Documento){
                        $('#archivoExistente').data('nombre', c.Documento);
                        $('#btnPreviewAcuerdo').off('click').on('click', function(){
                            const url = `/archivo/acuerdos/${c.Documento}`;
                            window.open(url, '_blank');
                        });
                    } else {
                        $('#contenedorPreviewAcuerdo').hide();
                    }
                }
            });

            // 🔒 MODO LECTURA
            if (modo === "lectura") {

                $('#modalAcuerdo input, #modalAcuerdo select, #modalAcuerdo textarea')
                    .prop('disabled', true);

                $('#archivo').prop('disabled', true);

                $('#modalAcuerdo .btn-primary').hide();
            }
            else {

                $('#modalAcuerdo input, #modalAcuerdo select, #modalAcuerdo textarea')
                    .prop('disabled', false);

                $('#archivo').prop('disabled', false);

                $('#modalAcuerdo .btn-primary').show();
            }


            new bootstrap.Modal('#modalAcuerdo').show();
        }

        function previsualizarArchivoAcuerdo() {
            let input = document.getElementById('archivo');
            let contenedor = document.getElementById('contenedorPreviewAcuerdo');
            let link = document.getElementById('linkPreviewAcuerdo');

            if (input.files.length === 0) {
                contenedor.classList.add('d-none');
                link.href = '#';
                return;
            }

            let file = input.files[0];
            link.href = URL.createObjectURL(file);
            contenedor.classList.remove('d-none');
        }

        // Función genérica para cargar combos con selección
        function cargarCombo(selector, url, selectedId = 0, esMoneda = false) {
            return new Promise((resolve) => {
                $.get(url, function (data) {
                    let cb = $(selector);
                    cb.empty();
                    data.forEach(d => {
                        if (esMoneda) {
                            cb.append(`<option value="${d.id}" data-simbolo="${d.simbolo}">${d.nombre}</option>`);
                        } else {
                            cb.append(`<option value="${d.id}">${d.nombre}</option>`);
                        }
                    });

                    if (selectedId) cb.val(selectedId);

                    // Si es combo de moneda, actualizar símbolo
                    if (esMoneda) actualizarSimbolo();

                    resolve();
                });
            });
        }

        // Funciones para cargar combos
        function cargarModalidades() {
            $.get('/ModalidadOperacion/Listar', data => {
                let cb = $('#cbomodalidad');
                cb.empty();
                data.forEach(m => cb.append(`<option value="${m.id}">${m.nombre}</option>`));
            });
        }
        function cargarTipoRebate() {
            $.get('/TipoRebate/Listar', data => {
                let cb = $('#cbotiporebate');
                cb.empty();
                data.forEach(t => cb.append(`<option value="${t.id}">${t.nombre}</option>`));
            });
        }
        function cargarCriterios() {
            $.get('/CriterioRebate/Listar', data => {
                let cb = $('#cbocriterio');
                cb.empty();
                data.forEach(c => cb.append(`<option value="${c.id}">${c.nombre}</option>`));
            });
        }
        function cargarPaises() {
            $.get('/Pais/ListarPaises', data => {
                let cb = $('#cbopais');
                cb.empty();
                data.forEach(p => cb.append(`<option value="${p.id}">${p.nombre}</option>`));
            });
        }
        function cargarMonedas() {
            $.get('/Moneda/ListarMonedas', function (data) {
                let cb = $('#cbomoneda');
                cb.empty();
                data.forEach(m => cb.append(`<option value="${m.id}" data-simbolo="${m.simbolo}">${m.nombre}</option>`));
                actualizarSimbolo();
            });
        }

        $('#cbomoneda').change(actualizarSimbolo);
        function actualizarSimbolo() {
            let selected = $('#cbomoneda option:selected');
            let simbolo = selected.data('simbolo') || '';
            $('#spanSimbolo').text(simbolo);
        }

        // Modal de selección de proveedor
        function abrirModalProveedor() {
            $.get('/Proveedores/Listar', function (data) {
                let tbody = $('#tablaProveedores tbody');
                tbody.empty();
                data.forEach(p => {
                    tbody.append(`
                        <tr data-id="${p.idProveedor}" data-nombre="${p.nombre}">
                            <td>${p.ruc}</td>
                            <td>${p.nombre}</td>
                        </tr>
                    `);
                });

                $('#tablaProveedores tbody tr').click(function () {
                    let id = $(this).data('id');
                    let nombre = $(this).data('nombre');
                    $('#cboproveedor').val(id);
                    $('#txtProveedorNombre').val(nombre);
                    bootstrap.Modal.getInstance(document.getElementById('modalProveedor')).hide();
                });
            });
            $('#txtFiltrarProveedor').val('');
            new bootstrap.Modal('#modalProveedor').show();
        }

        $('#txtFiltrarProveedor').on('keyup', function () {
            let valor = $(this).val().toLowerCase();
            $('#tablaProveedores tbody tr').filter(function () {
                $(this).toggle($(this).text().toLowerCase().indexOf(valor) > -1);
            });
        });

        // Guardar Acuerdo
                    function guardarAcuerdo() {
            $('#mensajeError, #mensajeOk').addClass('d-none').text('');

            let idAcuerdo = parseInt($('#txtid').val()) || 0;
            let archivo = $('#archivo')[0].files[0];                     // archivo nuevo
            let documentoExistente = $('#archivoExistente').data('nombre') || ''; // archivo existente

            let formData = new FormData();
            formData.append("IdAcuerdo", idAcuerdo);
            formData.append("NombreAcuerdo", $('#txtnombre').val());
            formData.append("IdProveedor", $('#cboproveedor').val());
            formData.append("IdModalidadOp", $('#cbomodalidad').val());
            formData.append("IdTipoRebate", $('#cbotiporebate').val());
            formData.append("IdCriterio", $('#cbocriterio').val());
            formData.append("ValorCriterio", $('#txtvalor').val());
            formData.append("Ganancia", $('#txtganancia').val());
            formData.append("IdPais", $('#cbopais').val());
            formData.append("IdMoneda", $('#cbomoneda').val());
            formData.append("FechaInicio", $('#txtinicio').val());
            formData.append("FechaFin", $('#txtfin').val());
            formData.append("Comentario", $('#txtcomentario').val());
            formData.append("UsuarioCreacion", $('#txtUsuarioRegistro').val());

            // Enviar archivo solo si es nuevo
            if (archivo) {
                formData.append("archivo", archivo);
            } else {
                formData.append("DOCUMENTO_EXISTENTE", documentoExistente);
            }

            $.ajax({
                type: "POST",
                url: idAcuerdo === 0 ? '/AcuerdoRebate/Crear' : '/AcuerdoRebate/Editar',
                data: formData,
                contentType: false,
                processData: false,
                success: function (res) {
                    if (res.success) {
                        bootstrap.Modal.getInstance(document.getElementById('modalAcuerdo')).hide();
                        $('#cuerpoExito').html(res.mensajes.join('<br/>'));
                        new bootstrap.Modal('#modalExito').show();
                        setTimeout(() => location.reload(), 1500);
                    } else {
                        $('#mensajeError').removeClass('d-none').html(res.mensajes.join('<br/>'));
                    }
                },
                error: function () {
                    $('#mensajeError').removeClass('d-none').html('<p>Error de comunicación con el servidor.</p>');
                }
            });
        }
    </script>
}
